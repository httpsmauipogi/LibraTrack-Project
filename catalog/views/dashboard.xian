{{> head }}
<body class="bg-slate-50 font-sans text-slate-800 antialiased min-h-screen flex flex-col">
{{> navbar}}

<main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">
  <div id="toast-container" class="fixed top-5 right-5 z-50 flex flex-col gap-2 pointer-events-none"></div>

  <!-- Page heading -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
    <div>
      <h1 class="text-2xl font-extrabold text-slate-900">Catalog Administration</h1>
      <p class="text-sm text-slate-500 mt-1">
        Catalog administrator <span class="font-semibold text-slate-700">{{adminUser.name}}</span>
        <span class="lt-badge bg-indigo-50 text-indigo-700 capitalize ml-1">{{adminUser.role}}</span>
      </p>
    </div>
    <button onclick="startNewBookEntry()" class="lt-btn shrink-0">
      <i class="fa-solid fa-plus"></i> Add New Book
    </button>
  </div>

  <!-- Tabs -->
  <nav class="flex flex-wrap gap-1 rounded-2xl bg-white border border-slate-200 shadow-card p-1.5">
    <button onclick="switchAdminTab('overview')" id="admin-nav-overview" class="admin-nav-item flex-1 min-w-[140px] rounded-xl px-4 py-2.5 text-sm font-bold bg-indigo-600 text-white shadow-sm transition-colors">
      <i class="fa-solid fa-chart-pie mr-2"></i>Overview
    </button>
    <button onclick="switchAdminTab('inventory')" id="admin-nav-inventory" class="admin-nav-item flex-1 min-w-[140px] rounded-xl px-4 py-2.5 text-sm font-bold text-slate-500 hover:text-slate-900 hover:bg-slate-50 transition-colors">
      <i class="fa-solid fa-books mr-2"></i>Book Inventory
    </button>
    <button onclick="switchAdminTab('borrowed')" id="admin-nav-borrowed" class="admin-nav-item flex-1 min-w-[140px] rounded-xl px-4 py-2.5 text-sm font-bold text-slate-500 hover:text-slate-900 hover:bg-slate-50 transition-colors">
      <i class="fa-solid fa-right-left mr-2"></i>Borrow Logs
      <span id="admin-badge-pending" class="ml-1.5 hidden rounded-full bg-amber-100 text-amber-700 text-xs px-2 py-0.5">0</span>
      <span id="admin-badge-overdue" class="ml-1.5 hidden rounded-full bg-rose-100 text-rose-700 text-xs px-2 py-0.5">0</span>
    </button>
  </nav>

  <!-- OVERVIEW -->
  <section id="admin-tab-overview" class="admin-tab-content space-y-6">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <div class="lt-card p-5">
        <p class="text-xs font-bold uppercase tracking-wider text-slate-500">Total Inventory</p>
        <p id="admin-stat-total-books" class="text-3xl font-extrabold text-slate-900 mt-2">0</p>
        <p class="text-xs text-slate-500 mt-1">Cataloged physical copies</p>
      </div>
      <div class="lt-card p-5">
        <p class="text-xs font-bold uppercase tracking-wider text-slate-500">Active Borrowings</p>
        <p id="admin-stat-active-loans" class="text-3xl font-extrabold text-indigo-600 mt-2">0</p>
        <p class="text-xs text-slate-500 mt-1">Currently checked out</p>
      </div>
      <div class="lt-card p-5">
        <p class="text-xs font-bold uppercase tracking-wider text-slate-500">Overdue Items</p>
        <p id="admin-stat-overdue" class="text-3xl font-extrabold text-rose-600 mt-2">0</p>
        <p class="text-xs text-slate-500 mt-1">Require immediate return</p>
      </div>
      <div class="lt-card p-5">
        <p class="text-xs font-bold uppercase tracking-wider text-slate-500">Accrued Fines</p>
        <p id="admin-stat-total-fines" class="text-3xl font-extrabold text-amber-600 mt-2">₱0.00</p>
        <p class="text-xs text-slate-500 mt-1">₱0.50 per day late</p>
      </div>
    </div>

    <div class="rounded-2xl bg-gradient-to-r from-libra-deep via-indigo-800 to-indigo-600 p-6 text-white shadow-lift">
      <p class="text-xs font-bold uppercase tracking-[0.18em] text-indigo-200">Operations pulse</p>
      <h2 class="mt-2 text-2xl font-extrabold">Welcome back, {{adminUser.name}}</h2>
      <p class="mt-1 text-sm text-indigo-100/90">Review circulation history, process returns, and keep the shared catalog up to date.</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <div class="lt-card p-6 space-y-4">
        <h3 class="font-extrabold text-slate-900">Quick Actions</h3>
        <button onclick="startNewBookEntry()" class="w-full text-left rounded-xl border border-slate-200 hover:border-indigo-500 hover:bg-indigo-50/50 p-3 text-sm font-bold text-slate-800 flex items-center justify-between transition-colors">
          <span><i class="fa-solid fa-plus text-indigo-600 mr-2"></i> Add New Book Title</span>
          <i class="fa-solid fa-chevron-right text-slate-400"></i>
        </button>
        <button onclick="switchAdminTab('borrowed')" class="w-full text-left rounded-xl border border-slate-200 hover:border-indigo-500 hover:bg-indigo-50/50 p-3 text-sm font-bold text-slate-800 flex items-center justify-between transition-colors">
          <span><i class="fa-solid fa-rotate-left text-indigo-600 mr-2"></i> Process Returns</span>
          <i class="fa-solid fa-chevron-right text-slate-400"></i>
        </button>
      </div>

      <div class="lt-card p-6 space-y-4 lg:col-span-2">
        <h3 class="font-extrabold text-slate-900">Recent Circulation</h3>
        <div id="admin-recent-feed" class="space-y-3 max-h-[260px] overflow-y-auto custom-scrollbar">
          <!-- Populated from /api/loans -->
        </div>
      </div>
    </div>
  </section>

  <!-- INVENTORY -->
  <section id="admin-tab-inventory" class="admin-tab-content hidden space-y-5">
    <div class="lt-card p-4 flex flex-col md:flex-row justify-between gap-4">
      <div class="relative w-full md:w-96">
        <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400"></i>
        <input type="text" id="admin-inventory-search" oninput="renderAdminInventoryTable()" placeholder="Search title, author, or ISBN..." class="lt-input pl-10">
      </div>
    </div>

    <div class="lt-card overflow-hidden">
      <div class="overflow-x-auto custom-scrollbar">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-slate-50 text-slate-500 text-xs font-extrabold uppercase border-b border-slate-200">
              <th class="py-3.5 px-4">Book Title &amp; Author</th>
              <th class="py-3.5 px-4">ISBN</th>
              <th class="py-3.5 px-4">Category</th>
              <th class="py-3.5 px-4 text-center">Shelf</th>
              <th class="py-3.5 px-4 text-center">Total Copies</th>
              <th class="py-3.5 px-4 text-center">Available</th>
              <th class="py-3.5 px-4 text-right">Actions</th>
            </tr>
          </thead>
          <tbody id="admin-inventory-tbody" class="divide-y divide-slate-100 text-sm">
            <!-- Populated from /api/books -->
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- BORROW LOGS -->
  <section id="admin-tab-borrowed" class="admin-tab-content hidden space-y-5">
    <div class="lt-card p-4">
      <div class="relative w-full md:w-96">
        <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400"></i>
        <input type="text" id="admin-borrowed-search" oninput="renderAdminBorrowedTable()" placeholder="Search borrower or book..." class="lt-input pl-10">
      </div>
    </div>

    <div class="lt-card overflow-hidden">
      <div class="overflow-x-auto custom-scrollbar">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-slate-50 text-slate-500 text-xs font-extrabold uppercase border-b border-slate-200">
              <th class="py-3.5 px-4">ID</th>
              <th class="py-3.5 px-4">Book Title</th>
              <th class="py-3.5 px-4">Borrower</th>
              <th class="py-3.5 px-4">Issued</th>
              <th class="py-3.5 px-4">Due</th>
              <th class="py-3.5 px-4 text-center">Status</th>
              <th class="py-3.5 px-4 text-center">Fine</th>
              <th class="py-3.5 px-4 text-right">Actions</th>
            </tr>
          </thead>
          <tbody id="admin-borrowed-tbody" class="divide-y divide-slate-100 text-sm">
            <!-- Populated from /api/loans -->
          </tbody>
        </table>
      </div>
    </div>
  </section>
</main>

<!-- MODAL: ADD / EDIT BOOK -->
<div id="modal-add-book" class="fixed inset-0 bg-slate-950/70 backdrop-blur-sm z-50 flex items-center justify-center hidden p-4">
  <div class="bg-white rounded-2xl shadow-2xl w-full max-w-lg overflow-hidden border border-slate-200">
    <div class="px-6 py-4 border-b border-slate-200 flex items-center justify-between bg-slate-50">
      <h3 id="modal-book-title" class="font-extrabold text-slate-900">Add New Book Record</h3>
      <button onclick="closeModal('modal-add-book')" class="text-slate-400 hover:text-slate-700" aria-label="Close">
        <i class="fa-solid fa-xmark text-lg"></i>
      </button>
    </div>
    <form id="form-add-book" onsubmit="saveBookRecord(event)" class="p-6 space-y-4">
      <input type="hidden" id="book-edit-id">
      <div>
        <label class="lt-label" for="book-title-input">Book Title *</label>
        <input type="text" id="book-title-input" required class="lt-input">
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="lt-label" for="book-author-input">Author *</label>
          <input type="text" id="book-author-input" required class="lt-input">
        </div>
        <div>
          <label class="lt-label" for="book-isbn-input">ISBN *</label>
          <input type="text" id="book-isbn-input" required class="lt-input">
        </div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="lt-label" for="book-category-input">Category *</label>
          <select id="book-category-input" required class="lt-input">
            <option value="Science & Tech">Science & Tech</option>
            <option value="Fiction">Fiction</option>
            <option value="History">History</option>
            <option value="Biography">Biography</option>
          </select>
        </div>
        <div>
          <label class="lt-label" for="book-shelf-input">Shelf Location *</label>
          <input type="text" id="book-shelf-input" placeholder="e.g. Rack A-1" required class="lt-input">
        </div>
      </div>
      <div>
        <label class="lt-label" for="book-quantity-input">Copies *</label>
        <input type="number" id="book-quantity-input" min="1" value="4" required class="lt-input">
      </div>
      <div class="pt-4 border-t border-slate-200 flex justify-end gap-3">
        <button type="button" onclick="closeModal('modal-add-book')" class="lt-btn-ghost">Cancel</button>
        <button type="submit" class="lt-btn">Save Book</button>
      </div>
    </form>
  </div>
</div>

<script>
  let books = [];
  let transactions = [];
  const todayStr = new Date().toISOString().split('T')[0];
  const finePerDay = 0.5;

  const apiRequest = async (url, options = {}) => {
    const response = await fetch(url, {
      ...options,
      headers: { 'Content-Type': 'application/json', ...(options.headers || {}) }
    });
    const data = await response.json().catch(() => ({}));
    if (!response.ok) throw new Error(data.error || 'The request could not be completed.');
    return data;
  };

  const refreshLibraryViews = async () => {
    try {
      [books, transactions] = await Promise.all([
        apiRequest('/api/books'),
        apiRequest('/api/loans')
      ]);
      renderAdminDashboard();
    } catch (error) {
      showToast(error.message);
    }
  };

  document.addEventListener('DOMContentLoaded', refreshLibraryViews);

  function switchAdminTab(tabKey) {
    document.querySelectorAll('.admin-nav-item').forEach(el => {
      el.classList.remove('bg-indigo-600', 'text-white', 'shadow-sm');
      el.classList.add('text-slate-500', 'hover:text-slate-900', 'hover:bg-slate-50');
    });
    const activeNav = document.getElementById(`admin-nav-${tabKey}`);
    if (activeNav) {
      activeNav.classList.add('bg-indigo-600', 'text-white', 'shadow-sm');
      activeNav.classList.remove('text-slate-500');
    }
    document.querySelectorAll('.admin-tab-content').forEach(el => el.classList.add('hidden'));
    document.getElementById(`admin-tab-${tabKey}`)?.classList.remove('hidden');
  }

  function renderAdminDashboard() {
    const totalCopies = books.reduce((acc, b) => acc + (parseInt(b.totalCopies) || 0), 0);
    const active = transactions.filter(loan => loan.isActiveLoan);
    const pending = transactions.filter(loan => ['PENDING', 'APPROVED'].includes(loan.statusLabel));
    const overdue = active.filter(loan => loan.dueDate && loan.dueDate < todayStr);
    const totalFines = overdue.reduce((sum, loan) => {
      const daysLate = Math.ceil((new Date(todayStr) - new Date(loan.dueDate)) / 86400000);
      return sum + Math.max(0, daysLate) * finePerDay;
    }, 0);

    document.getElementById('admin-stat-total-books').textContent = totalCopies;
    document.getElementById('admin-stat-active-loans').textContent = active.length;
    document.getElementById('admin-stat-overdue').textContent = overdue.length;
    document.getElementById('admin-stat-total-fines').textContent = `₱${totalFines.toFixed(2)}`;

    const pendingBadge = document.getElementById('admin-badge-pending');
    pendingBadge.textContent = pending.length;
    pendingBadge.classList.toggle('hidden', pending.length === 0);

    const overdueBadge = document.getElementById('admin-badge-overdue');
    overdueBadge.textContent = overdue.length;
    overdueBadge.classList.toggle('hidden', overdue.length === 0);

    renderAdminRecentFeed();
    renderAdminInventoryTable();
    renderAdminBorrowedTable();
  }

  function renderAdminRecentFeed() {
    const feed = document.getElementById('admin-recent-feed');
    feed.innerHTML = '';
    const recent = transactions.slice(0, 5);

    if (recent.length === 0) {
      feed.innerHTML = '<p class="py-6 text-center text-sm text-slate-400">No circulation records yet.</p>';
      return;
    }

    recent.forEach(loan => {
      const status = loan.statusLabel || 'PENDING';
      const tone = status === 'RETURNED'
        ? 'bg-emerald-50 text-emerald-700'
        : status === 'OVERDUE' || status === 'REJECTED'
          ? 'bg-rose-50 text-rose-700'
          : status === 'ACTIVE'
            ? 'bg-indigo-50 text-indigo-700'
            : 'bg-amber-50 text-amber-700';
      const item = document.createElement('div');
      item.className = 'flex items-center justify-between gap-3 rounded-xl bg-slate-50 border border-slate-100 p-3 text-xs';
      item.innerHTML = `
        <div class="min-w-0">
          <p class="font-bold text-slate-900 truncate">${escapeHtml(loan.Book?.title || 'Book')}</p>
          <p class="text-slate-500">Borrower: ${escapeHtml(loan.User?.name || 'Unknown')}</p>
        </div>
        <span class="lt-badge shrink-0 ${tone}">${escapeHtml(status)}</span>
      `;
      feed.appendChild(item);
    });
  }

  function renderAdminInventoryTable() {
    const tbody = document.getElementById('admin-inventory-tbody');
    const searchVal = (document.getElementById('admin-inventory-search').value || '').toLowerCase();
    tbody.innerHTML = '';

    const filtered = books.filter(b =>
      [b.title, b.author, b.isbn].some(field => String(field || '').toLowerCase().includes(searchVal))
    );

    if (filtered.length === 0) {
      tbody.innerHTML = '<tr><td colspan="7" class="p-8 text-center text-slate-400">No books in inventory. Use “Add New Book” to add titles.</td></tr>';
      return;
    }

    filtered.forEach(b => {
      const tr = document.createElement('tr');
      tr.className = 'border-b border-slate-100 hover:bg-slate-50';
      tr.innerHTML = `
        <td class="py-3 px-4 font-bold text-slate-900">${escapeHtml(b.title)} <span class="block text-xs text-slate-400 font-normal">${escapeHtml(b.author)}</span></td>
        <td class="py-3 px-4 text-xs text-slate-600">${escapeHtml(b.isbn)}</td>
        <td class="py-3 px-4"><span class="rounded-lg bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-600">${escapeHtml(b.category)}</span></td>
        <td class="py-3 px-4 text-center text-xs font-semibold text-slate-600">${escapeHtml(b.shelf)}</td>
        <td class="py-3 px-4 text-center font-bold text-slate-800">${b.totalCopies}</td>
        <td class="py-3 px-4 text-center font-bold ${b.availableCopies > 0 ? 'text-indigo-600' : 'text-rose-600'}">${b.availableCopies}</td>
        <td class="py-3 px-4 text-right whitespace-nowrap">
          <button onclick="editAdminBook('${b.id}')" class="p-1.5 text-slate-400 hover:text-indigo-600" aria-label="Edit"><i class="fa-solid fa-pen-to-square"></i></button>
          <button onclick="deleteAdminBook('${b.id}')" class="p-1.5 text-slate-400 hover:text-rose-600" aria-label="Delete"><i class="fa-solid fa-trash-can"></i></button>
        </td>
      `;
      tbody.appendChild(tr);
    });
  }

  function startNewBookEntry() {
    document.getElementById('form-add-book').reset();
    document.getElementById('book-edit-id').value = '';
    document.getElementById('book-title-input').value = '';
    document.getElementById('book-author-input').value = '';
    document.getElementById('book-isbn-input').value = '';
    document.getElementById('book-shelf-input').value = '';
    document.getElementById('book-quantity-input').value = '4';
    document.getElementById('modal-book-title').textContent = 'Add New Book Record';
    openModal('modal-add-book');
  }

  function editAdminBook(id) {
    const book = books.find(b => String(b.id) === String(id));
    if (!book) return;
    document.getElementById('modal-book-title').textContent = 'Edit Book Details';
    document.getElementById('book-edit-id').value = book.id;
    document.getElementById('book-title-input').value = book.title;
    document.getElementById('book-author-input').value = book.author;
    document.getElementById('book-isbn-input').value = book.isbn;
    document.getElementById('book-category-input').value = book.category;
    document.getElementById('book-shelf-input').value = book.shelf;
    document.getElementById('book-quantity-input').value = book.totalCopies;
    openModal('modal-add-book');
  }

  async function deleteAdminBook(id) {
    try {
      await apiRequest(`/api/books/${id}`, { method: 'DELETE' });
      showToast('Book removed from the catalog');
      await refreshLibraryViews();
    } catch (error) {
      showToast(error.message);
    }
  }

  async function saveBookRecord(event) {
    event.preventDefault();
    const editId = document.getElementById('book-edit-id').value;
    const payload = {
      title: document.getElementById('book-title-input').value.trim(),
      author: document.getElementById('book-author-input').value.trim(),
      isbn: document.getElementById('book-isbn-input').value.trim(),
      category: document.getElementById('book-category-input').value,
      shelf: document.getElementById('book-shelf-input').value.trim(),
      quantity: document.getElementById('book-quantity-input').value
    };

    try {
      await apiRequest(editId ? `/api/books/${editId}` : '/api/books', {
        method: editId ? 'PUT' : 'POST',
        body: JSON.stringify(payload)
      });
      showToast(editId ? 'Book updated' : `Added "${payload.title}" to inventory`);
      closeModal('modal-add-book');
      await refreshLibraryViews();
    } catch (error) {
      showToast(error.message);
    }
  }

  function renderAdminBorrowedTable() {
    const tbody = document.getElementById('admin-borrowed-tbody');
    const searchVal = (document.getElementById('admin-borrowed-search').value || '').toLowerCase();
    tbody.innerHTML = '';

    const filtered = transactions.filter(loan => {
      const haystack = [
        loan.Book?.title, loan.User?.name, loan.User?.email, loan.statusLabel
      ].join(' ').toLowerCase();
      return haystack.includes(searchVal);
    });

    if (filtered.length === 0) {
      tbody.innerHTML = '<tr><td colspan="8" class="p-8 text-center text-slate-400">No borrowing records found.</td></tr>';
      return;
    }

    filtered.forEach(loan => {
      const status = loan.statusLabel || 'PENDING';
      const returned = status === 'RETURNED';
      const daysLate = loan.dueDate
        ? Math.max(0, Math.ceil((new Date(todayStr) - new Date(loan.dueDate)) / 86400000))
        : 0;
      const overdue = loan.isActiveLoan && daysLate > 0;
      const fine = overdue ? daysLate * finePerDay : 0;
      const tone = returned
        ? 'bg-slate-100 text-slate-600'
        : overdue || status === 'REJECTED'
          ? 'bg-rose-50 text-rose-700'
          : status === 'ACTIVE'
            ? 'bg-indigo-50 text-indigo-700'
            : 'bg-amber-50 text-amber-700';

      let action;
      if (loan.isActiveLoan) {
        action = `<button onclick="processAdminReturn(${Number(loan.id)})" class="rounded-lg bg-emerald-600 hover:bg-emerald-700 px-3 py-1.5 text-xs font-bold text-white shadow-sm">Process Return</button>`;
      } else if (status === 'PENDING' || status === 'APPROVED') {
        action = `<a href="http://localhost:3000/admin/requests" class="text-xs font-semibold text-indigo-600 hover:underline">Review in Admin Console</a>`;
      } else {
        action = `<span class="text-xs text-slate-400">${returned ? `Returned ${escapeHtml(String(loan.returnedAt || '').slice(0, 10))}` : 'Closed'}</span>`;
      }

      const tr = document.createElement('tr');
      tr.className = 'border-b border-slate-100 hover:bg-slate-50';
      tr.innerHTML = `
        <td class="py-3 px-4 text-xs font-bold text-slate-500">${loan.id}</td>
        <td class="py-3 px-4 font-bold text-slate-900">${escapeHtml(loan.Book?.title || 'Book removed')}</td>
        <td class="py-3 px-4 font-semibold text-slate-700">${escapeHtml(loan.User?.name || 'Unknown')}<span class="block text-xs text-slate-400 font-normal">${escapeHtml(loan.User?.email || '')}</span></td>
        <td class="py-3 px-4 text-xs text-slate-500">${escapeHtml(String(loan.borrowDate || loan.createdAt || '').slice(0, 10))}</td>
        <td class="py-3 px-4 text-xs font-semibold text-slate-700">${escapeHtml(loan.dueDate || '—')}</td>
        <td class="py-3 px-4 text-center"><span class="lt-badge ${tone}">${escapeHtml(status)}</span></td>
        <td class="py-3 px-4 text-center text-xs font-bold ${overdue ? 'text-rose-600' : 'text-slate-400'}">₱${fine.toFixed(2)}</td>
        <td class="py-3 px-4 text-right whitespace-nowrap">${action}</td>
      `;
      tbody.appendChild(tr);
    });
  }

  async function processAdminReturn(loanId) {
    try {
      await apiRequest(`/api/loans/${loanId}/return`, { method: 'POST' });
      showToast('Return processed successfully');
      await refreshLibraryViews();
    } catch (error) {
      showToast(error.message);
    }
  }

  function openModal(id) {
    document.getElementById(id).classList.remove('hidden');
  }

  function closeModal(id) {
    document.getElementById(id).classList.add('hidden');
  }

  function showToast(message) {
    const container = document.getElementById('toast-container');
    const toast = document.createElement('div');
    toast.className = 'pointer-events-auto rounded-xl bg-slate-900 text-white text-xs font-bold px-4 py-3 shadow-xl border border-white/10 flex items-center gap-2 transition-all duration-300 opacity-0 translate-y-2';
    toast.innerHTML = `<i class="fa-solid fa-circle-check text-emerald-400"></i> ${escapeHtml(message)}`;
    container.appendChild(toast);
    requestAnimationFrame(() => toast.classList.remove('opacity-0', 'translate-y-2'));
    setTimeout(() => {
      toast.classList.add('opacity-0', 'translate-y-2');
      setTimeout(() => toast.remove(), 300);
    }, 3000);
  }

  function escapeHtml(value) {
    return String(value ?? '').replace(/[&<>"']/g, m => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
    })[m]);
  }
</script>
{{> footer }}
