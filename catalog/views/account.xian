{{> head}}
<body class="min-h-screen bg-slate-50 font-sans text-slate-800">
  <main class="mx-auto flex min-h-screen max-w-3xl items-center justify-center px-4 py-12">
    <section class="w-full rounded-2xl border border-slate-200 bg-white p-8 shadow-sm sm:p-10">
      <div class="mb-8 flex items-center gap-3">
        <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-indigo-600 text-lg text-white">
          <i class="fa-solid fa-book-open"></i>
        </div>
        <div>
          <p class="text-xs font-bold uppercase tracking-wider text-indigo-600">LibraTrack</p>
          <h1 class="text-xl font-extrabold text-slate-900">Your account</h1>
        </div>
      </div>

      <p class="mb-6 text-sm text-slate-600">You are signed in.</p>
      <dl class="space-y-4 rounded-xl bg-slate-50 p-5">
        <div>
          <dt class="text-xs font-bold uppercase tracking-wider text-slate-500">Name</dt>
          <dd class="mt-1 font-semibold text-slate-900">{{user.name}}</dd>
        </div>
        <div>
          <dt class="text-xs font-bold uppercase tracking-wider text-slate-500">Email</dt>
          <dd class="mt-1 font-semibold text-slate-900">{{user.email}}</dd>
        </div>
        <div>
          <dt class="text-xs font-bold uppercase tracking-wider text-slate-500">Account type</dt>
          <dd class="mt-1 font-semibold capitalize text-slate-900">{{user.role}}</dd>
        </div>
      </dl>

      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/" class="rounded-lg border border-slate-300 px-4 py-2.5 text-sm font-bold text-slate-700 hover:bg-slate-50">Home</a>
        <a href="/logout" class="rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-bold text-white hover:bg-indigo-700">Log out</a>
      </div>
    </section>
  </main>
{{> footer}}
