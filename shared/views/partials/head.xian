<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{#if title}}{{ title }} — {{/if}}LibraTrack</title>

  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans: ['Inter', 'ui-sans-serif', 'system-ui', 'sans-serif'] },
          colors: {
            // One palette for every LibraTrack portal.
            libra: {
              deep: '#1e1b4b',
              accent: '#4f46e5',
              accentHover: '#4338ca',
              lightBg: '#f8fafc'
            },
            // Make betlog's gray-* utilities resolve to the same slate shades
            // used by libratrack/catalog, so every page matches.
            gray: {
              50: '#f8fafc', 100: '#f1f5f9', 200: '#e2e8f0', 300: '#cbd5e1',
              400: '#94a3b8', 500: '#64748b', 600: '#475569', 700: '#334155',
              800: '#1e293b', 900: '#0f172a', 950: '#020617'
            }
          },
          borderRadius: { '2xl': '1rem', '3xl': '1.25rem' },
          boxShadow: {
            card: '0 1px 2px 0 rgb(15 23 42 / 0.04), 0 1px 3px 0 rgb(15 23 42 / 0.06)',
            lift: '0 10px 25px -5px rgb(15 23 42 / 0.12)'
          }
        }
      }
    };
  </script>

  <style type="text/tailwindcss">
    html { scroll-behavior: smooth; }
    body { font-feature-settings: 'cv11', 'ss01'; }
    .custom-scrollbar::-webkit-scrollbar { width: 6px; height: 6px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: #f1f5f9; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 3px; }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
    .view-section { display: none; }
    .view-section.active-view { display: block; }

    /* Shared component primitives keep all portals visually consistent. */
    .lt-card { @apply bg-white rounded-2xl border border-slate-200 shadow-card; }
    .lt-input { @apply w-full rounded-xl border border-slate-300 bg-slate-50 px-3.5 py-2.5 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500; }
    .lt-btn { @apply inline-flex items-center justify-center gap-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-sm px-5 py-2.5 transition-colors shadow-sm; }
    .lt-btn-ghost { @apply inline-flex items-center justify-center gap-2 rounded-xl border border-slate-300 bg-white text-slate-700 hover:bg-slate-50 font-semibold text-sm px-4 py-2 transition-colors; }
    .lt-label { @apply block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1.5; }
    .lt-badge { @apply inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold; }
  </style>
</head>