<header class="bg-libra-deep text-white border-b border-indigo-950 sticky top-0 z-40 shadow-md">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-3 shrink-0">
      <span class="w-9 h-9 rounded-xl bg-indigo-600 flex items-center justify-center text-white text-lg shadow-lg shadow-indigo-600/30">
        <i class="fa-solid fa-book-open"></i>
      </span>
      <span>
        <span class="block font-extrabold text-white text-base tracking-tight leading-tight">LibraTrack</span>
        <span class="block text-[10px] text-indigo-300 uppercase tracking-wider">Integrated Library System</span>
      </span>
    </a>

    <nav class="hidden md:flex items-center gap-6 text-sm font-semibold text-indigo-100">
      {{#if (or currentUser user)}}
        <a href="/dashboard" class="hover:text-white transition-colors {{#if (eq currentPath '/dashboard')}}text-white{{/if}}">Dashboard</a>
      {{/if}}
      <a href="{{#if catalogUrl}}{{catalogUrl}}{{else}}/books{{/if}}" class="hover:text-white transition-colors {{#if (eq currentPath '/books')}}text-white{{/if}}">Catalog</a>
      {{#if (or currentUser user)}}
        {{#if (or isAdmin (eq user.role "admin") (eq user.role "staff") (eq currentUser.role "admin") (eq currentUser.role "staff"))}}
          {{#unless hideReviewLink}}
            <a href="{{#if reviewUrl}}{{reviewUrl}}{{else}}/admin/borrowings{{/if}}" class="hover:text-white transition-colors">Review Requests</a>
          {{/unless}}
        {{else}}
          <a href="/borrowings" class="hover:text-white transition-colors {{#if (eq currentPath '/borrowings')}}text-white{{/if}}">My Borrowings</a>
        {{/if}}
      {{/if}}
    </nav>

    {{#unless hideAuthLinks}}
      <div class="flex items-center gap-3">
        {{#if (or currentUser user)}}
          <span class="hidden sm:inline-flex items-center gap-2 rounded-full bg-white/10 border border-white/10 px-3 py-1.5 text-xs font-semibold">
            <span class="w-6 h-6 rounded-full bg-indigo-500 flex items-center justify-center text-[11px] font-bold">
              {{#if currentUser}}{{initial currentUser.name}}{{else}}{{initial user.name}}{{/if}}
            </span>
            <span class="hidden lg:inline">{{#if currentUser}}{{currentUser.name}}{{else}}{{user.name}}{{/if}}</span>
          </span>
          <a href="/logout" class="rounded-xl bg-white/10 hover:bg-white/20 px-3.5 py-2 text-xs font-bold transition-colors">
            <i class="fa-solid fa-right-from-bracket mr-1"></i>Sign out
          </a>
        {{else}}
          <a href="/login" class="rounded-xl bg-indigo-600 hover:bg-indigo-500 px-4 py-2 text-sm font-bold transition-colors">
            <i class="fa-solid fa-right-to-bracket mr-1"></i>Sign in
          </a>
        {{/if}}
      </div>
    {{/unless}}
  </div>
</header>

{{#each success_msg}}
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-4">
    <div class="rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 px-4 py-3 text-sm" role="status">{{this}}</div>
  </div>
{{/each}}
{{#each error_msg}}
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-4">
    <div class="rounded-xl bg-rose-50 border border-rose-200 text-rose-800 px-4 py-3 text-sm" role="alert">{{this}}</div>
  </div>
{{/each}}