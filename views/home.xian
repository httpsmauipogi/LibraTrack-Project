{{> head}}
<body class="bg-gray-50">
{{> navbar}}

<!-- Hero -->
<section class="bg-gradient-to-r from-indigo-700 to-blue-700 text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24 text-center">
    <h1 class="text-4xl md:text-5xl font-extrabold mb-4">BetLog Library</h1>
    <p class="text-lg md:text-xl text-indigo-100 max-w-2xl mx-auto mb-8">Borrow and return books online. Browse the catalog, submit a request, and track your borrowings — all in one place.</p>
    <div class="flex justify-center gap-4 flex-wrap">
      <a href="/books" class="px-8 py-3 bg-white text-indigo-700 font-semibold rounded-lg hover:bg-indigo-50">Browse Books</a>
      {{#if user}}
        <a href="/borrowings" class="px-8 py-3 bg-white/10 border border-white/40 text-white font-semibold rounded-lg hover:bg-white/20">My Borrowings</a>
      {{else}}
        <a href="/register" class="px-8 py-3 bg-white/10 border border-white/40 text-white font-semibold rounded-lg hover:bg-white/20">Get a Library Card</a>
      {{/if}}
    </div>
    <div class="mt-10 max-w-xl mx-auto">
      <form action="/books" method="GET" class="flex">
        <input name="q" type="text" placeholder="Search by title or author..." class="w-full px-5 py-3 rounded-l-lg text-gray-800 outline-none"/>
        <button type="submit" class="px-6 py-3 bg-indigo-900/60 hover:bg-indigo-900 text-white rounded-r-lg font-medium">Search</button>
      </form>
    </div>
  </div>
</section>

<!-- Genres -->
{{#if genres.length}}
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
  <div class="flex flex-wrap gap-3 justify-center">
    {{#each genres}}
      <a href="/books?genre={{this}}" class="px-4 py-2 bg-white border border-gray-200 rounded-full text-sm text-gray-700 hover:border-indigo-400 hover:text-indigo-600">{{this}}</a>
    {{/each}}
  </div>
</section>
{{/if}}

<!-- Featured books -->
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
  <div class="flex justify-between items-end mb-8">
    <div>
      <h2 class="text-2xl font-bold text-gray-900">All Books</h2>
      <p class="text-gray-500 mt-1">Browse the library collection</p>
    </div>
    <a href="/books" class="text-sm text-indigo-600 hover:underline font-medium">View catalog &rarr;</a>
  </div>

  {{#if featured.length}}
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {{#each featured}}
        <a href="/books/{{this.id}}" class="bg-white rounded-xl shadow border border-gray-100 p-6 hover:shadow-md transition group">
          <div class="flex justify-between items-start gap-3">
            <h3 class="font-semibold text-gray-900 line-clamp-2 group-hover:text-indigo-600">{{this.title}}</h3>
            <span class="shrink-0 px-2 py-0.5 text-xs font-medium rounded {{#if this.available}}bg-green-100 text-green-700{{else}}bg-red-100 text-red-700{{/if}}">{{#if this.available}}Available{{else}}Unavailable{{/if}}</span>
          </div>
          <p class="text-sm text-gray-500 mt-1">{{this.author}}</p>
          <p class="text-xs text-indigo-600 mt-2">{{this.genre}}</p>
          <p class="text-xs text-gray-400 mt-3">{{this.available}} of {{this.copies}} copies available</p>
        </a>
      {{/each}}
    </div>
  {{else}}
    <div class="text-center py-16 bg-white rounded-xl border border-gray-100">
      <p class="text-gray-500">No books in the library yet.</p>
    </div>
  {{/if}}
</section>

<!-- How it works -->
<section class="bg-white border-y border-gray-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <h2 class="text-2xl font-bold text-center text-gray-900 mb-10">How It Works</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="text-center">
        <div class="w-14 h-14 mx-auto rounded-full bg-indigo-100 text-indigo-600 flex items-center justify-center text-xl font-bold">1</div>
        <h3 class="mt-4 font-semibold text-gray-900">Browse &amp; Request</h3>
        <p class="text-sm text-gray-500 mt-1">Find a book and submit a borrow request.</p>
      </div>
      <div class="text-center">
        <div class="w-14 h-14 mx-auto rounded-full bg-indigo-100 text-indigo-600 flex items-center justify-center text-xl font-bold">2</div>
        <h3 class="mt-4 font-semibold text-gray-900">Approval</h3>
        <p class="text-sm text-gray-500 mt-1">Library staff approves your request.</p>
      </div>
      <div class="text-center">
        <div class="w-14 h-14 mx-auto rounded-full bg-indigo-100 text-indigo-600 flex items-center justify-center text-xl font-bold">3</div>
        <h3 class="mt-4 font-semibold text-gray-900">Return</h3>
        <p class="text-sm text-gray-500 mt-1">Return the book when you're done.</p>
      </div>
    </div>
  </div>
</section>

{{> footer}}