{{> head}}
<body class="min-h-screen bg-slate-100 text-slate-800 antialiased">
  <header class="bg-slate-900 text-white">
    <div class="mx-auto flex w-full max-w-6xl flex-wrap items-center justify-between gap-3 px-4 py-3 sm:px-6 sm:py-0 lg:h-16 lg:px-8">
      <div class="flex min-w-0 items-center gap-3">
        <div class="grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-emerald-500 text-lg font-bold text-white">L</div>
        <div class="flex min-w-0 flex-wrap items-center gap-2">
          <span class="truncate font-bold tracking-tight">LibraTrack</span>
          <span class="rounded-full border border-emerald-400/30 bg-emerald-500/15 px-2 py-0.5 text-[11px] font-semibold uppercase tracking-wider text-emerald-300">Admin</span>
        </div>
      </div>
      <nav class="flex flex-wrap items-center gap-3 text-sm sm:gap-4">
        <a href="/dashboard" class="min-h-[44px] whitespace-nowrap text-slate-300 hover:text-white sm:min-h-0">Member Portal</a>
        <span class="hidden text-slate-400 sm:inline">|</span>
        <span class="hidden text-slate-300 sm:inline">Public console</span>
      </nav>
    </div>
  </header>

  <main class="mx-auto w-full max-w-6xl space-y-6 px-4 py-6 sm:space-y-8 sm:px-6 sm:py-10 lg:px-8">
    {{#each error_msg}}
      <div class="rounded-xl bg-red-50 border border-red-200 px-4 py-3 text-sm text-red-700" role="alert">{{this}}</div>
    {{/each}}
    {{#each success_msg}}
      <div class="rounded-xl bg-emerald-50 border border-emerald-200 px-4 py-3 text-sm text-emerald-700" role="status">{{this}}</div>
    {{/each}}

    <div>
      <h1 class="text-2xl font-extrabold text-slate-900 sm:text-3xl">Administrator Console</h1>
      <p class="text-sm text-slate-500 mt-1">Public admin console &middot; no sign-in required</p>
    </div>

    <section>
      <h2 class="font-bold text-slate-900 mb-3">Connected portals</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {{#each portals}}
          <a href="{{ url }}" target="_blank" rel="noopener noreferrer" class="group bg-white rounded-2xl border border-slate-200 p-5 shadow-xs hover:border-indigo-300 hover:shadow-md transition">
            <p class="font-bold text-slate-900 group-hover:text-indigo-700">{{ label }}</p>
            <p class="text-xs text-slate-500 mt-1">{{ description }}</p>
            <span class="inline-block mt-4 text-xs font-semibold text-indigo-600">Open admin &rarr;</span>
          </a>
        {{/each}}
      </div>
    </section>

    <section class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-xs">
        <p class="text-xs uppercase tracking-wider text-slate-500">Catalog books</p>
        <p class="text-3xl font-bold text-slate-900 mt-1">{{ stats.books }}</p>
      </div>
      <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-xs">
        <p class="text-xs uppercase tracking-wider text-slate-500">Pending requests</p>
        <p class="text-3xl font-bold text-slate-900 mt-1">{{ stats.requests }}</p>
      </div>
      <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-xs">
        <p class="text-xs uppercase tracking-wider text-slate-500">Active loans</p>
        <p class="text-3xl font-bold text-slate-900 mt-1">{{ stats.loans }}</p>
      </div>
    </section>

    <section class="bg-white rounded-2xl border border-slate-200 shadow-xs overflow-hidden">
      <div class="px-6 py-5 border-b border-slate-200">
        <h2 class="font-bold text-slate-900">Registered accounts</h2>
        <p class="text-xs text-slate-500 mt-1">Password hashes are never exposed here.</p>
      </div>
      <div class="lt-table-wrap custom-scrollbar">
        <table class="lt-table">
          <thead class="bg-slate-50 text-slate-500 text-xs uppercase tracking-wider">
            <tr>
              <th class="px-3 py-3 text-left sm:px-6">Name</th>
              <th class="px-3 py-3 text-left sm:px-6">Email</th>
              <th class="px-3 py-3 text-left sm:px-6">Member ID</th>
              <th class="px-3 py-3 text-left sm:px-6">Role</th>
              <th class="px-3 py-3 text-left sm:px-6">Joined</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {{#each users}}
              <tr>
                <td class="px-3 py-3 sm:px-6 font-medium text-slate-900">{{ name }}</td>
                <td class="px-3 py-3 sm:px-6 text-slate-600">{{ email }}</td>
                <td class="px-3 py-3 sm:px-6 font-mono text-xs text-slate-500">{{ memberId }}</td>
                <td class="px-3 py-3 sm:px-6"><span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs font-semibold text-slate-700">{{ role }}</span></td>
                <td class="px-3 py-3 sm:px-6 text-slate-500">{{ joined }}</td>
              </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    </section>
  </main>
  {{> footer}}
</body>
