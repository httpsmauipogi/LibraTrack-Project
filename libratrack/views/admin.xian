{{> head}}
<body class="min-h-screen bg-slate-100 text-slate-800 antialiased">
  <header class="bg-slate-900 text-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-xl bg-emerald-500 text-white font-bold text-lg flex items-center justify-center">L</div>
        <div>
          <span class="font-bold tracking-tight">LibraTrack</span>
          <span class="ml-2 text-[11px] font-semibold uppercase tracking-wider bg-emerald-500/15 text-emerald-300 border border-emerald-400/30 px-2 py-0.5 rounded-full">Admin</span>
        </div>
      </div>
      <nav class="flex items-center gap-4 text-sm">
        <a href="/dashboard" class="text-slate-300 hover:text-white">Member Portal</a>
        <span class="hidden sm:inline text-slate-400">|</span>
        <span class="hidden sm:inline text-slate-300">Public console</span>
      </nav>
    </div>
  </header>

  <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8">
    {{#each error_msg}}
      <div class="rounded-xl bg-red-50 border border-red-200 px-4 py-3 text-sm text-red-700" role="alert">{{this}}</div>
    {{/each}}
    {{#each success_msg}}
      <div class="rounded-xl bg-emerald-50 border border-emerald-200 px-4 py-3 text-sm text-emerald-700" role="status">{{this}}</div>
    {{/each}}

    <div>
      <h1 class="text-2xl font-bold text-slate-900">Administrator Console</h1>
      <p class="text-sm text-slate-500 mt-1">Public admin console &middot; no sign-in required</p>
    </div>

    <section>
      <h2 class="font-bold text-slate-900 mb-3">Connected portals</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {{#each portals}}
          <a href="{{ url }}" target="_blank" rel="noopener noreferrer" class="group bg-white rounded-2xl border border-slate-200 p-5 shadow-xs hover:border-indigo-300 hover:shadow-md transition">
            <p class="font-bold text-slate-900 group-hover:text-indigo-700">{{ label }}</p>
            <p class="text-xs text-slate-500 mt-1">{{ description }}</p>
            <span class="inline-block mt-4 text-xs font-semibold text-indigo-600">Open admin &rarr;</span>
          </a>
        {{/each}}
      </div>
    </section>

    <section class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-xs">
        <p class="text-xs uppercase tracking-wider text-slate-500">Catalog books</p>
        <p class="text-3xl font-bold text-slate-900 mt-1">{{ stats.books }}</p>
      </div>
      <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-xs">
        <p class="text-xs uppercase tracking-wider text-slate-500">Pending requests</p>
        <p class="text-3xl font-bold text-slate-900 mt-1">{{ stats.requests }}</p>
      </div>
      <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-xs">
        <p class="text-xs uppercase tracking-wider text-slate-500">Active loans</p>
        <p class="text-3xl font-bold text-slate-900 mt-1">{{ stats.loans }}</p>
      </div>
    </section>

    <section class="bg-white rounded-2xl border border-slate-200 shadow-xs overflow-hidden">
      <div class="px-6 py-5 border-b border-slate-200">
        <h2 class="font-bold text-slate-900">Registered accounts</h2>
        <p class="text-xs text-slate-500 mt-1">Password hashes are never exposed here.</p>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="bg-slate-50 text-slate-500 text-xs uppercase tracking-wider">
            <tr>
              <th class="text-left px-6 py-3">Name</th>
              <th class="text-left px-6 py-3">Email</th>
              <th class="text-left px-6 py-3">Member ID</th>
              <th class="text-left px-6 py-3">Role</th>
              <th class="text-left px-6 py-3">Joined</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {{#each users}}
              <tr>
                <td class="px-6 py-3 font-medium text-slate-900">{{ name }}</td>
                <td class="px-6 py-3 text-slate-600">{{ email }}</td>
                <td class="px-6 py-3 font-mono text-xs text-slate-500">{{ memberId }}</td>
                <td class="px-6 py-3"><span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs font-semibold text-slate-700">{{ role }}</span></td>
                <td class="px-6 py-3 text-slate-500">{{ joined }}</td>
              </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    </section>
  </main>
  {{> footer}}
</body>
