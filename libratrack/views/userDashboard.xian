{{> head}}
<body data-user-id="{{ user.id }}" data-user-name="{{ user.name }}" class="bg-slate-50 text-slate-800 font-sans antialiased min-h-screen flex flex-col">

  <!-- Toast Notification -->
  <div id="toast-box" class="pointer-events-none fixed bottom-4 left-4 right-4 z-50 flex flex-col gap-2 sm:bottom-5 sm:left-auto sm:right-5"></div>

  <!-- Member Top Navbar -->
  <header class="sticky top-0 z-30 border-b border-slate-200 bg-white/90 backdrop-blur-md">
    <div class="mx-auto flex w-full max-w-7xl flex-wrap items-center justify-between gap-3 px-4 py-3 sm:px-6 sm:py-0 lg:h-16 lg:px-8">
      <div class="flex min-w-0 items-center gap-2.5">
        <div class="grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-indigo-600 text-xl font-bold text-white shadow-xs">L</div>
        <span class="truncate text-lg font-extrabold tracking-tight text-slate-900 sm:text-xl">LibraTrack</span>
      </div>

      <!-- Swipeable tab row on phones; inline from laptop widths up -->
      <nav class="custom-scrollbar order-3 -mx-4 flex w-full items-center gap-2 overflow-x-auto whitespace-nowrap px-4 pb-1 sm:px-6 lg:order-none lg:mx-0 lg:w-auto lg:overflow-visible lg:px-0 lg:pb-0" aria-label="Member navigation">
        {{#if isAdmin}}
          <a href="/admin" class="inline-flex min-h-[44px] shrink-0 items-center rounded-full bg-amber-100 px-3 py-2 text-xs font-semibold text-amber-800 transition hover:bg-amber-200 sm:px-4 sm:text-sm">Admin Console</a>
        {{/if}}
        <button onclick="switchPage('explore')" id="nav-explore" class="inline-flex min-h-[44px] shrink-0 items-center rounded-full bg-slate-900 px-3 py-2 text-xs font-semibold text-white transition sm:px-4 sm:text-sm">
          Explore Books
        </button>
        <button onclick="switchPage('account')" id="nav-account" class="inline-flex min-h-[44px] shrink-0 items-center gap-2 rounded-full px-3 py-2 text-xs font-semibold text-slate-600 transition hover:bg-slate-100 sm:px-4 sm:text-sm">
          <span>My Books & Requests</span>
          <span id="member-badge" class="rounded-full bg-indigo-600 px-2 py-0.5 text-xs font-bold text-white">0</span>
        </button>
        <a href="/logout" class="inline-flex min-h-[44px] shrink-0 items-center gap-2 rounded-full px-3 py-2 text-xs font-semibold text-slate-600 transition hover:bg-slate-100 hover:text-rose-600 sm:text-sm" title="Log out">
          <i class="fa-solid fa-right-from-bracket"></i>
          <span>Log out</span>
        </a>
      </nav>

      <div class="hidden items-center gap-2.5 border-l border-slate-200 pl-4 lg:flex">
        <div class="text-right">
          <p class="text-xs font-bold text-slate-900" id="patron-name-display">{{ user.name }}</p>
          <p class="text-[11px] font-semibold text-slate-500" id="patron-id-display">ID: {{ user.id }}</p>
        </div>
        <div class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-indigo-100 text-xs font-bold text-indigo-700">MC</div>
      </div>
    </div>
  </header>

  <!-- PAGE 1: EXPLORE CATALOG -->
  <main id="page-explore" class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Hero Search Section -->
    <div class="mb-6 rounded-3xl bg-gradient-to-br from-libra-deep via-indigo-800 to-indigo-950 p-5 text-white shadow-lg sm:p-8 lg:p-10">
      <div class="max-w-2xl">
        <span class="text-xs font-semibold uppercase tracking-widest text-indigo-200">Digital Library Catalog</span>
        <h1 class="mt-2 text-2xl font-extrabold leading-tight sm:text-3xl lg:text-4xl">
          Find your next reference, textbook, or classic read.
        </h1>
        <p class="mt-2 text-sm text-indigo-200">
          Search real-time shelf availability and reserve books online for instant pickup at the library counter.
        </p>
      </div>

      <div class="mt-5 flex flex-col gap-2 rounded-2xl bg-white p-2 text-slate-800 shadow-md sm:flex-row sm:items-center">
        <input type="text" id="search-input" oninput="renderCatalog()" placeholder="Search title, author, ISBN, or topic..." class="min-w-0 flex-1 rounded-xl px-4 py-2.5 text-base focus:outline-none sm:text-sm">
        <select id="category-select" onchange="renderCatalog()" class="min-h-[44px] w-full rounded-xl border border-slate-200 bg-slate-100 px-4 py-2.5 text-sm font-medium text-slate-700 focus:outline-none sm:w-auto">
          <option value="All">All Subjects</option>
          <option value="Computer Science">Computer Science</option>
          <option value="Engineering">Engineering</option>
          <option value="Literature">Literature</option>
          <option value="History">History</option>
        </select>
        <select id="availability-select" onchange="renderCatalog()" class="min-h-[44px] w-full rounded-xl border border-slate-200 bg-slate-100 px-4 py-2.5 text-sm font-medium text-slate-700 focus:outline-none sm:w-auto">
          <option value="All">All Status</option>
          <option value="Available">Available Only</option>
        </select>
      </div>
    </div>

    <!-- Results Header -->
    <div class="mb-5 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
      <h2 class="text-xl font-extrabold text-slate-900">Catalog Collection</h2>
      <span id="results-label" class="text-xs font-medium text-slate-500">Loading books...</span>
    </div>

    <!-- Book Cards Grid -->
    <div id="catalog-grid" class="grid grid-cols-1 gap-4 sm:grid-cols-2 sm:gap-6 lg:grid-cols-3 xl:grid-cols-4"></div>
  </main>

  <!-- PAGE 2: MY BORROWED BOOKS & RESERVATION HOLDS -->
  <main id="page-account" class="hidden flex-1 max-w-5xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
    <div>
      <h1 class="text-2xl font-extrabold text-slate-900 sm:text-3xl">My Library Activity</h1>
      <p class="mt-1 text-sm text-slate-500">Borrow requests sent here are synced directly to the Librarian Admin System.</p>
    </div>

    <!-- Pending Holds -->
    <section class="rounded-2xl border border-slate-200 bg-white p-4 shadow-xs sm:p-6">
      <div class="mb-4 flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between">
        <h2 class="text-base font-bold text-slate-900">Borrow Requests</h2>
        <span class="text-xs font-semibold text-slate-400">Endpoint: GET /api/member/requests</span>
      </div>
      <div id="my-requests-container" class="grid grid-cols-1 gap-4 md:grid-cols-2"></div>
    </section>

    <!-- Active Borrowed Books -->
    <section class="rounded-2xl border border-slate-200 bg-white p-4 shadow-xs sm:p-6">
      <div class="mb-4 flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between">
        <h2 class="text-base font-bold text-slate-900">Currently Borrowed Books</h2>
        <span class="text-xs font-semibold text-slate-400">Endpoint: GET /api/member/loans</span>
      </div>
      <div class="lt-table-wrap custom-scrollbar">
        <table class="lt-table">
          <thead>
            <tr class="border-b border-slate-200 text-xs uppercase text-slate-400">
              <th class="py-3 px-3">Book Title</th>
              <th class="py-3 px-3">Date Borrowed</th>
              <th class="py-3 px-3">Due Date</th>
              <th class="py-3 px-3">Status</th>
            </tr>
          </thead>
          <tbody id="my-loans-tbody" class="divide-y divide-slate-100"></tbody>
        </table>
      </div>
    </section>
  </main>

  <!-- Borrow Request Modal -->
  <div id="reserve-modal" class="fixed inset-0 z-40 hidden items-center justify-center bg-slate-950/60 p-3 backdrop-blur-xs sm:p-6">
    <div class="lt-modal-panel max-w-md">
      <div class="lt-modal-body">
        <span id="modal-cat" class="rounded-full bg-indigo-50 px-2.5 py-1 text-[11px] font-bold uppercase tracking-wider text-indigo-600">Category</span>
        <h3 id="modal-title" class="mt-3 text-xl font-extrabold text-slate-900">Book Title</h3>
        <p id="modal-author" class="text-sm text-slate-500">Author</p>

        <div class="mt-4 space-y-2 rounded-xl border border-slate-200 bg-slate-50 p-4 text-xs">
          <div class="flex flex-wrap justify-between gap-x-3">
            <span class="text-slate-500">Call / Shelf Number</span>
            <span id="modal-shelf" class="font-bold text-slate-900"></span>
          </div>
          <div class="flex flex-wrap justify-between gap-x-3">
            <span class="text-slate-500">ISBN</span>
            <span id="modal-isbn" class="font-semibold text-slate-700"></span>
          </div>
          <div class="flex flex-wrap justify-between gap-x-3">
            <span class="text-slate-500">Copies Available</span>
            <span id="modal-avail" class="font-bold text-indigo-600"></span>
          </div>
        </div>

        <div class="mt-4">
          <label for="pickup-note" class="mb-1 block text-xs font-semibold text-slate-700">Note for Librarian</label>
          <input type="text" id="pickup-note" placeholder="e.g., Needed for a class project" class="lt-input">
        </div>
      </div>

      <div class="lt-modal-actions">
        <button onclick="closeModal()" class="lt-btn-ghost w-full sm:w-auto">Cancel</button>
        <button onclick="submitBorrowRequest()" class="lt-btn w-full sm:w-auto">
          Submit Borrow Request
        </button>
      </div>
    </div>
  </div>

  <script>
    /**
     * Borrow requests are persisted through the shared member API.
     */
    const API_CONFIG = {
      MEMBER: {
        id: document.body.dataset.userId || 'MEM-2026-001',
        name: document.body.dataset.userName || 'Signed in user'
      }
    };

    // Drop the old demo data cached by previous versions of this page.
    if (!localStorage.getItem('lt_seeds_cleared_v3')) {
      localStorage.removeItem('lt_integrated_books');
      localStorage.removeItem('lt_integrated_holds');
      localStorage.removeItem('lt_integrated_loans');
      localStorage.setItem('lt_seeds_cleared_v3', '1');
    }

    let catalogBooks = [];
    let memberLoans = [];
    let memberRequests = [];

    const loadMemberLoans = async () => {
      try {
        const response = await fetch('/api/member/loans');
        memberLoans = response.ok ? await response.json() : [];
      } catch {
        memberLoans = [];
      }
    };

    const loadMemberRequests = async () => {
      try {
        const response = await fetch('/api/member/requests');
        memberRequests = response.ok ? await response.json() : [];
      } catch {
        memberRequests = [];
      }
    };

    const loadCatalogBooks = async () => {
      try {
        const response = await fetch('/api/books');
        catalogBooks = response.ok ? await response.json() : [];
      } catch {
        catalogBooks = [];
      }
    };

    const MemberApiService = {
      getBooks() {
        return catalogBooks;
      },
      getRequests() {
        return memberRequests;
      },
      getLoans() {
        return memberLoans;
      },
      async createRequest(payload) {
        const response = await fetch('/api/member/requests', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const data = await response.json();
        if (!response.ok) throw new Error(data.error || 'Could not submit your request.');
        memberRequests.unshift(data);
        return data;
      },
      async cancelRequest(requestId) {
        const response = await fetch(`/api/member/requests/${encodeURIComponent(requestId)}`, {
          method: 'DELETE'
        });
        const data = await response.json();
        if (!response.ok) throw new Error(data.error || 'Could not cancel your request.');
        memberRequests = memberRequests.filter(h => h.id !== Number(requestId));
        return data;
      }
    };

    let activeBook = null;

    // Refresh the book list when the tab is revisited or another tab changes data.
    const refreshCatalog = async () => {
      await loadCatalogBooks();
      renderCatalog();
    };

    window.addEventListener('storage', async () => {
      await Promise.all([refreshCatalog(), loadMemberLoans(), loadMemberRequests()]);
      renderAccount();
    });
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) {
        refreshCatalog();
        Promise.all([loadMemberLoans(), loadMemberRequests()]).then(renderAccount);
      }
    });

    function notify(msg) {
      const box = document.getElementById('toast-box');
      const el = document.createElement('div');
      el.className = 'pointer-events-auto bg-slate-900 text-white px-4 py-3 rounded-xl shadow-lg text-xs font-semibold border-l-4 border-indigo-500';
      el.textContent = msg;
      box.appendChild(el);
      setTimeout(() => el.remove(), 3000);
    }

    function switchPage(page) {
      document.getElementById('page-explore').classList.toggle('hidden', page !== 'explore');
      document.getElementById('page-account').classList.toggle('hidden', page !== 'account');

      // Toggle state only so the responsive sizing classes stay intact.
      [['nav-explore', page === 'explore'], ['nav-account', page === 'account']].forEach(([id, isActive]) => {
        const tab = document.getElementById(id);
        if (!tab) return;
        tab.classList.toggle('bg-slate-900', isActive);
        tab.classList.toggle('text-white', isActive);
        tab.classList.toggle('text-slate-600', !isActive);
        tab.classList.toggle('hover:bg-slate-100', !isActive);
      });

      if (page === 'account') renderAccount();
    }

    function renderCatalog() {
      const books = MemberApiService.getBooks();
      const requests = MemberApiService.getRequests();
      const q = document.getElementById('search-input').value.toLowerCase();
      const cat = document.getElementById('category-select').value;
      const avail = document.getElementById('availability-select').value;

      const filtered = books.filter(b =>
        (b.title.toLowerCase().includes(q) || b.author.toLowerCase().includes(q) || b.isbn.includes(q)) &&
        (cat === 'All' || b.category === cat) &&
        (avail === 'All' || b.available > 0)
      );

      document.getElementById('results-label').textContent = `${filtered.length} books found`;

      document.getElementById('catalog-grid').innerHTML = filtered.map(b => {
        const isAvailable = b.available > 0;
        const hasPending = requests.some(h => h.bookId === b.id && h.rawStatus === 'pending');

        return `
          <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-xs hover:shadow-md transition flex flex-col">
            <div class="bg-gradient-to-br ${b.accent || 'from-indigo-700 to-libra-deep'} p-5 text-white">
              <span class="text-[10px] font-bold uppercase tracking-wider bg-white/20 px-2 py-0.5 rounded-full">${b.category}</span>
              <h3 class="font-bold font-bold text-lg mt-3 leading-snug line-clamp-2">${b.title}</h3>
              <p class="text-xs text-white/80 mt-1">${b.author}</p>
            </div>
            <div class="p-4 flex-1 flex flex-col justify-between space-y-4">
              <div class="space-y-1.5 text-xs">
                <div class="flex justify-between">
                  <span class="text-slate-400">Shelf Location</span>
                  <span class="font-semibold font-semibold text-slate-800">${b.shelf}</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-slate-400">Status</span>
                  <span class="font-semibold ${isAvailable ? 'text-indigo-600' : 'text-amber-600'}">
                    ${isAvailable ? `${b.available} / ${b.total} on shelf` : 'Waitlist Only'}
                  </span>
                </div>
              </div>
              ${hasPending
                ? `<button disabled class="w-full py-2.5 rounded-xl bg-slate-100 text-slate-400 text-xs font-bold cursor-not-allowed">Request Pending</button>`
                : `<button onclick="openModal(${b.id})" class="w-full py-2.5 rounded-xl ${isAvailable ? 'bg-indigo-600 hover:bg-indigo-700 text-white' : 'bg-amber-500 hover:bg-amber-600 text-slate-950'} text-xs font-bold transition">
                    ${isAvailable ? 'Request to Borrow' : 'Request Waitlist Borrow'}
                  </button>`
              }
            </div>
          </div>
        `;
      }).join('');

      updateBadge();
    }

    function openModal(bookId) {
      activeBook = MemberApiService.getBooks().find(b => b.id === bookId);
      if (!activeBook) return;

      document.getElementById('modal-cat').textContent = activeBook.category;
      document.getElementById('modal-title').textContent = activeBook.title;
      document.getElementById('modal-author').textContent = activeBook.author;
      document.getElementById('modal-shelf').textContent = activeBook.shelf;
      document.getElementById('modal-isbn').textContent = activeBook.isbn;
      document.getElementById('modal-avail').textContent = `${activeBook.available} of ${activeBook.total} copies`;
      document.getElementById('pickup-note').value = '';

      const m = document.getElementById('reserve-modal');
      m.classList.remove('hidden');
      m.classList.add('flex');
    }

    function closeModal() {
      const m = document.getElementById('reserve-modal');
      m.classList.add('hidden');
      m.classList.remove('flex');
    }

    async function submitBorrowRequest() {
      if (!activeBook) return;
      const button = event?.target;
      if (button) button.disabled = true;
      try {
        const request = await MemberApiService.createRequest({
          bookId: activeBook.id,
          note: document.getElementById('pickup-note').value.trim()
        });
        closeModal();
        renderCatalog();
        renderAccount();
        notify(`${request.requestId} sent to Librarian Desk for review!`);
      } catch (error) {
        notify(error.message);
      } finally {
        if (button) button.disabled = false;
      }
    }

    async function cancelMyRequest(requestId) {
      try {
        await MemberApiService.cancelRequest(requestId);
        renderCatalog();
        renderAccount();
        notify('Borrow request cancelled.');
      } catch (error) {
        notify(error.message);
      }
    }

    function renderAccount() {
      const requests = MemberApiService.getRequests();
      const loans = MemberApiService.getLoans();

      document.getElementById('my-requests-container').innerHTML = requests.length
        ? requests.map(h => `
          <div class="flex flex-wrap items-center justify-between gap-3 rounded-xl border border-slate-200 bg-slate-50 p-4">
            <div>
              <span class="text-[10px] font-bold px-2 py-0.5 rounded bg-amber-100 text-amber-800">${h.requestId} &bull; ${h.status}</span>
              <h4 class="font-bold text-slate-900 text-sm mt-1">${h.bookTitle}</h4>
              <p class="text-xs text-slate-500">Shelf: <span class="font-semibold">${h.shelf}</span> &bull; ${h.createdAt}</p>
            </div>
            ${h.rawStatus === 'pending' ? `<button onclick="cancelMyRequest(${h.id})" class="text-xs font-semibold text-rose-600 hover:underline">Cancel</button>` : ''}
          </div>
        `).join('')
        : `<p class="text-xs text-slate-400 col-span-2">No borrow requests yet.</p>`;

      document.getElementById('my-loans-tbody').innerHTML = loans.length
        ? loans.map(l => `
          <tr>
            <td class="py-3 px-3 font-semibold text-slate-900">${l.bookTitle}</td>
            <td class="py-3 px-3 font-semibold text-xs text-slate-500">${l.borrowDate}</td>
            <td class="py-3 px-3 font-semibold text-xs font-bold text-amber-700">${l.dueDate}</td>
            <td class="py-3 px-3"><span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-indigo-50 text-indigo-600">${l.status}</span></td>
          </tr>
        `).join('')
        : `<tr><td colspan="4" class="py-6 text-center text-xs text-slate-400">No active borrowed books.</td></tr>`;

      updateBadge();
    }

    function updateBadge() {
      const requests = MemberApiService.getRequests().filter(h => h.rawStatus === 'pending').length;
      const loans = MemberApiService.getLoans().length;
      document.getElementById('member-badge').textContent = requests + loans;
    }

    (async () => {
      await Promise.all([loadCatalogBooks(), loadMemberLoans(), loadMemberRequests()]);
      renderCatalog();
      renderAccount();
    })();
  </script>
</body>
{{> footer}}