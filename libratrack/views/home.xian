{{> head }}
<body class="bg-slate-50 font-sans text-slate-800 antialiased min-h-screen flex flex-col custom-scrollbar">

    <!-- Toast Notification Container -->
    <div id="toast-container" class="pointer-events-none fixed left-4 right-4 top-4 z-50 flex flex-col gap-2 sm:left-auto sm:right-5 sm:top-5"></div>

    <!-- ================= VIEW 1: PUBLIC HOME PAGE ================= -->
    <div id="view-home" class="view-section active-view flex-1 flex flex-col">
        <!-- Public Top Header Navigation -->
        <header class="sticky top-0 z-40 border-b border-indigo-950 bg-libra-deep text-white shadow-md">
            <div class="mx-auto flex w-full max-w-7xl flex-wrap items-center justify-between gap-x-4 gap-y-2 px-4 py-3 sm:px-6 sm:py-0 lg:h-20 lg:px-8">
                <!-- Brand -->
                <div class="flex min-w-0 cursor-pointer items-center gap-2.5 sm:gap-3" onclick="showPublicView('hero')">
                    <div class="grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-indigo-600 text-lg shadow-lg shadow-indigo-600/30 sm:h-10 sm:w-10 sm:text-xl">
                        <i class="fa-solid fa-book-open"></i>
                    </div>
                    <div class="min-w-0">
                        <h1 class="truncate text-lg font-extrabold leading-tight tracking-tight text-white sm:text-xl">LibraTrack</h1>
                        <span class="hidden text-[11px] text-indigo-200 sm:block">Integrated Library System</span>
                    </div>
                </div>

                <!-- Nav Links: swipeable on small screens, inline from tablet up -->
                <nav class="custom-scrollbar order-3 -mx-4 flex w-full items-center gap-5 overflow-x-auto whitespace-nowrap px-4 pb-1 text-sm font-semibold text-indigo-100 sm:order-none sm:mx-0 sm:w-auto sm:gap-6 sm:overflow-visible sm:px-0 md:gap-8" aria-label="Public navigation">
                    <a href="#hero" onclick="showPublicView('hero')" class="shrink-0 transition-colors hover:text-white">Home</a>
                    <a href="#public-catalog" onclick="showPublicView('catalog')" class="shrink-0 transition-colors hover:text-white">Book Catalog</a>
                    <a href="#services" onclick="showPublicView('services')" class="shrink-0 transition-colors hover:text-white">Library Services</a>
                    <a href="#about" onclick="showPublicView('about')" class="shrink-0 transition-colors hover:text-white">Hours & Info</a>
                </nav>

                <!-- Action Button -->
                <div class="flex shrink-0 items-center gap-2 sm:gap-3">
                    <a href="/login" class="inline-flex min-h-[44px] items-center gap-2 rounded-xl border border-indigo-400/30 bg-indigo-600 px-3 py-2 text-xs font-bold text-white shadow-md transition-all hover:bg-indigo-500 sm:px-5 sm:py-2.5 sm:text-sm">
                        <i class="fa-solid fa-right-to-bracket"></i><span class="hidden xs:inline">Login / Access Portal</span><span class="xs:hidden">Login</span>
                    </a>
                </div>
            </div>
        </header>

        <!-- Home Page Main Container -->
        <main class="flex-1">
            <!-- HERO SECTION -->
            <section id="hero-section" class="bg-gradient-to-b from-libra-deep via-indigo-950 to-slate-900 px-4 py-12 text-white sm:px-6 sm:py-16 lg:px-8 lg:py-24">
                <div class="max-w-7xl mx-auto text-center space-y-8">
                    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-indigo-500/20 border border-indigo-400/30 text-indigo-200 text-xs font-bold uppercase tracking-wider mb-2">
                        <i class="fa-solid fa-sparkles text-amber-400"></i> Modern Digital Library Infrastructure
                    </div>
                    <h1 class="mx-auto max-w-4xl text-3xl font-extrabold leading-tight tracking-tight sm:text-4xl md:text-5xl lg:text-6xl">
                        LibraTrack: Integrated Library & Borrowing System
                    </h1>
                    <p class="text-base sm:text-lg text-indigo-200/90 max-w-2xl mx-auto font-normal">
                        Explore thousands of books, manage borrowings, track return dates, and calculate late penalties dynamically through our real-time integrated portal.
                    </p>

                    <!-- Public Hero Search Bar -->
                    <div class="relative mx-auto w-full max-w-2xl">
                        <div class="flex flex-col gap-2 rounded-2xl border border-indigo-200 bg-white p-2 shadow-2xl sm:flex-row sm:items-center">
                            <i class="fa-solid fa-magnifying-glass ml-3 mr-1 hidden text-lg text-slate-400 sm:block" aria-hidden="true"></i>
                            <input type="text" id="public-hero-search-input" placeholder="Search by book title, author, category or ISBN..." class="min-w-0 flex-1 px-2 py-2.5 text-base font-medium text-slate-800 focus:outline-none sm:text-sm">
                            <button onclick="executePublicSearch()" class="inline-flex min-h-[44px] shrink-0 items-center justify-center gap-2 rounded-xl bg-indigo-600 px-5 py-2.5 text-sm font-bold text-white transition-colors hover:bg-indigo-700 sm:px-6 sm:py-3">
                                <i class="fa-solid fa-magnifying-glass sm:hidden" aria-hidden="true"></i>Search Catalog
                            </button>
                        </div>
                    </div>

                    <!-- Statistics Bar -->
                    <div class="mx-auto grid max-w-4xl grid-cols-2 gap-3 pt-6 text-left sm:gap-4 md:grid-cols-4">
                        <div class="rounded-2xl border border-white/10 bg-white/10 p-3 backdrop-blur-md sm:p-4">
                            <p class="text-[10px] font-bold uppercase text-indigo-300 sm:text-xs">Total Book Titles</p>
                            <h3 id="public-stat-titles" class="mt-1 text-xl font-extrabold text-white sm:text-2xl lg:text-3xl">0</h3>
                        </div>
                        <div class="rounded-2xl border border-white/10 bg-white/10 p-3 backdrop-blur-md sm:p-4">
                            <p class="text-[10px] font-bold uppercase text-indigo-300 sm:text-xs">Copies Available</p>
                            <h3 id="public-stat-available" class="mt-1 text-xl font-extrabold text-emerald-400 sm:text-2xl lg:text-3xl">0</h3>
                        </div>
                        <div class="rounded-2xl border border-white/10 bg-white/10 p-3 backdrop-blur-md sm:p-4">
                            <p class="text-[10px] font-bold uppercase text-indigo-300 sm:text-xs">Active Borrowers</p>
                            <h3 id="public-stat-patrons" class="mt-1 text-xl font-extrabold text-amber-400 sm:text-2xl lg:text-3xl">0</h3>
                        </div>
                        <div class="rounded-2xl border border-white/10 bg-white/10 p-3 backdrop-blur-md sm:p-4">
                            <p class="text-[10px] font-bold uppercase text-indigo-300 sm:text-xs">System Status</p>
                            <h3 class="mt-1 text-xl font-extrabold text-emerald-400 sm:text-2xl lg:text-3xl flex items-center gap-2">
                                <span class="w-3 h-3 rounded-full bg-emerald-400 animate-pulse"></span> Online
                            </h3>
                        </div>
                    </div>
                </div>
            </section>

            <!-- FEATURED BOOKS & PUBLIC CATALOG CATALOG -->
            <section id="public-catalog-section" class="mx-auto max-w-7xl space-y-6 px-4 py-12 sm:space-y-8 sm:px-6 sm:py-16 lg:px-8">
                <div class="flex flex-col justify-between gap-4 border-b border-slate-200 pb-4 md:flex-row md:items-end sm:pb-6">
                    <div>
                        <span class="text-xs font-bold uppercase text-indigo-600 tracking-wider">Public Inventory Browser</span>
                        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 mt-1">Featured & Available Catalog</h2>
                    </div>
                    <!-- Filters -->
                    <div class="flex flex-wrap items-center gap-3">
                        <select id="public-category-filter" onchange="renderPublicCatalog()" class="min-h-[44px] w-full rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 sm:w-auto">
                            <option value="ALL">All Categories</option>
                            <option value="Science & Tech">Science & Tech</option>
                            <option value="Fiction">Fiction</option>
                            <option value="History">History</option>
                            <option value="Biography">Biography</option>
                        </select>
                    </div>
                </div>

                <!-- Book Cards Grid -->
                <div id="public-books-grid" class="grid grid-cols-1 gap-4 sm:grid-cols-2 sm:gap-6 lg:grid-cols-3 xl:grid-cols-4">
                    <!-- Dynamically Populated -->
                </div>
            </section>

            <!-- SERVICES & NOTICE BOARD -->
            <section id="services-section" class="bg-slate-100 px-4 py-12 sm:px-6 sm:py-16 lg:px-8">
                <div class="mx-auto max-w-7xl space-y-8 sm:space-y-12">
                    <div class="text-center max-w-2xl mx-auto">
                        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900">Integrated Library Services</h2>
                        <p class="text-sm text-slate-500 mt-2">Comprehensive features for both students and library administrators</p>
                    </div>

                    <div class="grid grid-cols-1 gap-4 sm:gap-6 md:grid-cols-3">
                        <div class="space-y-3 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
                            <div class="w-12 h-12 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center text-xl font-bold">
                                <i class="fa-solid fa-book-bookmark"></i>
                            </div>
                            <h3 class="font-extrabold text-slate-900 text-lg">Automated Inventory</h3>
                            <p class="text-xs text-slate-500 leading-relaxed">Real-time shelf tracking, stock adjustments, category tagging, and location shelf assignment.</p>
                        </div>
                        <div class="space-y-3 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
                            <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center text-xl font-bold">
                                <i class="fa-solid fa-clock-rotate-left"></i>
                            </div>
                            <h3 class="font-extrabold text-slate-900 text-lg">Borrow & Return Engine</h3>
                            <p class="text-xs text-slate-500 leading-relaxed">Track active checkouts, issue dates, due dates, loan extensions, and automated late return fee computation ($0.50/day).</p>
                        </div>
                        <div class="space-y-3 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
                            <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-xl font-bold">
                                <i class="fa-solid fa-user-shield"></i>
                            </div>
                            <h3 class="font-extrabold text-slate-900 text-lg">Dual Role Dashboards</h3>
                            <p class="text-xs text-slate-500 leading-relaxed">Dedicated User Dashboard for student profile, balance, and borrowings, paired with a full Admin control suite.</p>
                        </div>
                    </div>
                </div>
            </section>
        </main>
    </div>

    <script>
        let books = [];
        let patrons = [];

        function updatePublicStats() {
            const totalTitles = books.length;
            const available = books.reduce((acc, b) => acc + parseInt(b.availableCopies || 0), 0);
            const titlesEl = document.getElementById('public-stat-titles');
            const availableEl = document.getElementById('public-stat-available');
            const patronsEl = document.getElementById('public-stat-patrons');

            if (titlesEl) titlesEl.textContent = totalTitles;
            if (availableEl) availableEl.textContent = available;
            if (patronsEl) patronsEl.textContent = patrons.length;
        }

        function escapeHtml(str) {
            return String(str).replace(/[&<>"']/g, (m) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m]));
        }

        function renderPublicCatalog() {
            const grid = document.getElementById('public-books-grid');
            if (!grid) return;

            const searchVal = (document.getElementById('public-hero-search-input')?.value || '').toLowerCase();
            const categoryVal = document.getElementById('public-category-filter')?.value || 'ALL';
            grid.innerHTML = '';

            const filtered = books.filter((b) => {
                const matchesSearch = !searchVal || b.title.toLowerCase().includes(searchVal) || b.author.toLowerCase().includes(searchVal) || b.isbn.toLowerCase().includes(searchVal);
                const matchesCat = categoryVal === 'ALL' || b.category === categoryVal;
                return matchesSearch && matchesCat;
            });

            if (filtered.length === 0) {
                grid.innerHTML = '<div class="col-span-full p-8 text-center text-slate-400 font-semibold">No books match your search parameters.</div>';
                return;
            }

            filtered.forEach((b) => {
                const card = document.createElement('div');
                const isAvailable = (b.availableCopies || 0) > 0;
                card.className = 'bg-white p-5 rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition-all flex flex-col justify-between';
                card.innerHTML = `
                    <div class="space-y-3">
                        <div class="w-full h-36 bg-slate-100 rounded-xl flex items-center justify-center text-indigo-400 border border-slate-200 text-3xl">
                            <i class="fa-solid fa-book"></i>
                        </div>
                        <div>
                            <span class="text-[11px] font-bold text-indigo-600 uppercase tracking-wider">${escapeHtml(b.category)}</span>
                            <h4 class="font-extrabold text-slate-900 text-base leading-snug line-clamp-1 mt-0.5">${escapeHtml(b.title)}</h4>
                            <p class="text-xs text-slate-500">${escapeHtml(b.author)}</p>
                        </div>
                    </div>
                    <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs">
                        <span class="font-semibold text-slate-500 font-mono">${escapeHtml(b.shelf)}</span>
                        <span class="font-bold ${isAvailable ? 'text-emerald-600' : 'text-rose-500'}">${isAvailable ? (b.availableCopies || 0) + ' Copies Left' : 'Out of Stock'}</span>
                    </div>
                `;
                grid.appendChild(card);
            });
        }

        function executePublicSearch() {
            renderPublicCatalog();
            document.getElementById('public-catalog-section')?.scrollIntoView({ behavior: 'smooth' });
        }

        function showPublicView(section) {
            if (section === 'catalog') {
                document.getElementById('public-catalog-section')?.scrollIntoView({ behavior: 'smooth' });
            } else if (section === 'services') {
                document.getElementById('services-section')?.scrollIntoView({ behavior: 'smooth' });
            } else if (section === 'hero') {
                window.scrollTo({ top: 0, behavior: 'smooth' });
            }
        }

        async function loadPublicCatalog() {
            try {
                const bookResponse = await fetch('/api/books');
                books = await bookResponse.json();
                patrons = [];
            } catch (error) {
                books = [];
                patrons = [];
            }
            updatePublicStats();
            renderPublicCatalog();
        }

        document.addEventListener('DOMContentLoaded', loadPublicCatalog);
    </script>
{{> footer }}