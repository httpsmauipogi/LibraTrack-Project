{{> head}}
<body class="min-h-screen bg-slate-100 text-slate-800 antialiased">
  <header class="bg-slate-900 text-white">
    <div class="mx-auto flex w-full max-w-6xl flex-wrap items-center justify-between gap-3 px-4 py-3 sm:px-6 sm:py-0 lg:h-16 lg:px-8">
      <div class="flex min-w-0 items-center gap-3">
        <div class="grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-amber-500 text-lg font-bold text-white">L</div>
        <div class="flex min-w-0 flex-wrap items-center gap-2">
          <span class="truncate font-bold tracking-tight">LibraTrack</span>
          <span class="rounded-full border border-amber-400/30 bg-amber-500/15 px-2 py-0.5 text-[11px] font-semibold uppercase tracking-wider text-amber-300">Requests</span>
        </div>
      </div>
      <nav class="flex flex-wrap items-center gap-3 text-sm sm:gap-4">
        <a href="/admin" class="min-h-[44px] whitespace-nowrap text-slate-300 hover:text-white sm:min-h-0">Admin Console</a>
        <span class="hidden text-slate-400 sm:inline">|</span>
        <span class="hidden text-slate-300 sm:inline">Public review</span>
      </nav>
    </div>
  </header>

  <main class="mx-auto w-full max-w-6xl space-y-6 px-4 py-6 sm:px-6 sm:py-10 lg:px-8">
    {{#each error_msg}}
      <div class="rounded-xl bg-red-50 border border-red-200 px-4 py-3 text-sm text-red-700" role="alert">{{this}}</div>
    {{/each}}
    {{#each success_msg}}
      <div class="rounded-xl bg-emerald-50 border border-emerald-200 px-4 py-3 text-sm text-emerald-700" role="status">{{this}}</div>
    {{/each}}

    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3">
      <div>
        <h1 class="text-2xl font-extrabold text-slate-900 sm:text-3xl">Borrow Requests</h1>
        <p class="text-sm text-slate-500 mt-1">Requests submitted by members from the LibraTrack dashboard.</p>
      </div>
      <a href="{{borrowPortalUrl}}/admin/borrowings" target="_blank" rel="noopener noreferrer" class="lt-btn-ghost w-full sm:w-auto">View Borrowed Books &rarr;</a>
    </div>

    <section class="bg-white rounded-2xl border border-slate-200 shadow-xs overflow-hidden">
      <div class="px-6 py-5 border-b border-slate-200">
        <h2 class="font-bold text-slate-900">Awaiting review</h2>
        <p class="text-xs text-slate-500 mt-1">Approved requests move to the borrowed-books list in the borrow portal.</p>
      </div>

      {{#if requests.length}}
        <div class="lt-table-wrap custom-scrollbar">
          <table class="lt-table">
            <thead class="bg-slate-50 text-slate-500 text-xs uppercase tracking-wider">
              <tr>
                <th class="text-left px-6 py-3">Request</th>
                <th class="text-left px-6 py-3">Member</th>
                <th class="text-left px-6 py-3">Book</th>
                <th class="text-left px-6 py-3">Note</th>
                <th class="text-left px-6 py-3">Submitted</th>
                <th class="text-right px-6 py-3">Action</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              {{#each requests}}
                <tr>
                  <td class="px-6 py-3">
                    <p class="font-mono text-xs text-slate-500">{{this.requestId}}</p>
                    <span class="text-[10px] font-bold uppercase text-amber-700">{{this.statusLabel}}</span>
                  </td>
                  <td class="px-6 py-3">
                    <p class="font-medium text-slate-900">{{this.memberName}}</p>
                    <p class="text-xs text-slate-500">{{this.memberEmail}}</p>
                  </td>
                  <td class="px-6 py-3">
                    <p class="font-medium text-slate-900">{{this.bookTitle}}</p>
                    <p class="text-xs text-slate-500">Shelf {{this.shelf}} &middot; ISBN {{this.isbn}}</p>
                  </td>
                  <td class="px-6 py-3 text-slate-600">{{this.note}}</td>
                  <td class="px-6 py-3 text-slate-500">{{this.createdAt}}</td>
                  <td class="px-6 py-3">
                    <div class="flex flex-wrap justify-end gap-2">
                      <form method="POST" action="/admin/requests/{{this.id}}/approve" onsubmit="return confirm('Approve this borrow request?')">
                        <button type="submit" class="inline-flex min-h-[36px] items-center rounded-lg bg-emerald-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-emerald-700">Approve</button>
                      </form>
                      <form method="POST" action="/admin/requests/{{this.id}}/reject" onsubmit="return confirm('Reject this borrow request?')">
                        <button type="submit" class="inline-flex min-h-[36px] items-center rounded-lg bg-rose-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-rose-700">Reject</button>
                      </form>
                    </div>
                  </td>
                </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
      {{else}}
        <div class="py-16 text-center">
          <i class="fa-solid fa-inbox text-4xl text-slate-300"></i>
          <p class="mt-3 text-sm text-slate-500">No pending borrow requests.</p>
          <p class="text-xs text-slate-400 mt-1">Members submit requests from the dashboard.</p>
        </div>
      {{/if}}
    </section>
  </main>
  {{> footer}}
</body>
