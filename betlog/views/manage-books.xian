{{> head}}
<body class="bg-gray-50">
{{> navbar}}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <h1 class="text-2xl font-bold text-gray-900 sm:text-3xl">Manage Books</h1>
    <a href="/admin/books/create" class="inline-flex min-h-[44px] items-center rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700">+ Add Book</a>
  </div>

  {{#if books.length}}
    <div class="lt-table-wrap custom-scrollbar rounded-xl border border-gray-100 bg-white shadow">
      <table class="lt-table divide-y divide-gray-100">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Book</th>
            <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Author</th>
            <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Category</th>
            <th class="px-6 py-3 text-center text-xs font-semibold text-gray-500 uppercase">Copies</th>
            <th class="px-6 py-3 text-center text-xs font-semibold text-gray-500 uppercase">Status</th>
            <th class="px-6 py-3 text-right text-xs font-semibold text-gray-500 uppercase">Action</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          {{#each books}}
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-4 text-sm font-medium text-gray-900">{{this.title}}</td>
              <td class="px-6 py-4 text-sm text-gray-600">{{this.author}}</td>
              <td class="px-6 py-4 text-sm text-indigo-600">{{this.category}}</td>
              <td class="px-6 py-4 text-center text-sm">{{this.available}}/{{this.copies}}</td>
              <td class="px-6 py-4 text-center">
                <form method="POST" action="/admin/books/{{this.id}}/toggle" class="inline">
                  <button type="submit" class="px-2 py-0.5 text-xs font-medium rounded capitalize {{#if (eq this.status 'available')}}bg-green-100 text-green-700{{else}}bg-gray-100 text-gray-600{{/if}}">{{this.status}}</button>
                </form>
              </td>
              <td class="px-6 py-4 text-right">
                <a href="/admin/books/{{this.id}}/edit" class="text-indigo-600 text-sm hover:underline mr-3">Edit</a>
                <form method="POST" action="/admin/books/{{this.id}}/delete" onsubmit="return confirm('Delete this book?')" class="inline">
                  <button type="submit" class="text-red-600 text-sm hover:underline">Delete</button>
                </form>
              </td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  {{else}}
    <div class="rounded-xl border border-gray-100 bg-white py-14 text-center sm:py-20">
      <p class="text-gray-500 text-lg">No books in the library.</p>
      <a href="/admin/books/create" class="mt-3 inline-block text-indigo-600 hover:underline">Add the first book</a>
    </div>
  {{/if}}
</div>
{{> footer}}