{{> head}}
<body class="bg-gray-50">
{{> navbar}}

<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="flex flex-col lg:flex-row gap-8">
    <!-- Sidebar filters -->
    <aside class="lg:w-64 flex-shrink-0">
      <div class="bg-white p-6 rounded-xl shadow border border-gray-100">
        <h3 class="font-semibold text-gray-900 mb-4">Categories</h3>
        <ul class="space-y-1 text-sm">
          <li>
            <a href="/books" class="block px-3 py-2 rounded-lg {{#unless genre}}bg-indigo-50 text-indigo-700 font-medium{{else}}text-gray-600 hover:bg-gray-50{{/unless}}">All Categories</a>
          </li>
          {{#each genres}}
            <li>
              <a href="/books?genre={{this}}" class="block px-3 py-2 rounded-lg {{#if (eq this ../genre)}}bg-indigo-50 text-indigo-700 font-medium{{else}}text-gray-600 hover:bg-gray-50{{/if}}">{{this}}</a>
            </li>
          {{/each}}
        </ul>
      </div>
      {{#if q}}
        <div class="mt-4 bg-white p-4 rounded-xl shadow border border-gray-100">
          <p class="text-sm text-gray-600">Results for <strong class="text-gray-900">"{{q}}"</strong></p>
          <a href="/books" class="text-xs text-indigo-600 hover:underline mt-1 inline-block">Clear search</a>
        </div>
      {{/if}}
    </aside>

    <!-- Book list -->
    <div class="flex-1">
      <div class="flex justify-between items-center mb-6">
        <h1 class="text-2xl font-bold text-gray-900">{{#if genre}}{{genre}}{{else}}Library Catalog{{/if}}</h1>
        <span class="text-sm text-gray-500">{{books.length}} book{{#if (ne books.length 1)}}s{{/if}}</span>
      </div>

      {{#if books.length}}
        <div class="bg-white rounded-xl shadow border border-gray-100 overflow-hidden">
          <table class="w-full divide-y divide-gray-100">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Title</th>
                <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Author</th>
                <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Category</th>
                <th class="px-6 py-3 text-center text-xs font-semibold text-gray-500 uppercase">Available</th>
                <th class="px-6 py-3 text-right text-xs font-semibold text-gray-500 uppercase">Action</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              {{#each books}}
                <tr class="hover:bg-gray-50">
                  <td class="px-6 py-4">
                    <a href="/books/{{this.id}}" class="text-sm font-medium text-gray-900 hover:text-indigo-600">{{this.title}}</a>
                  </td>
                  <td class="px-6 py-4 text-sm text-gray-600">{{this.author}}</td>
                  <td class="px-6 py-4 text-sm text-indigo-600">{{this.category}}</td>
                  <td class="px-6 py-4 text-center">
                    <span class="px-2 py-0.5 text-xs font-medium rounded {{#if this.available}}bg-green-100 text-green-700{{else}}bg-red-100 text-red-700{{/if}}">{{this.available}}/{{this.copies}}</span>
                  </td>
                  <td class="px-6 py-4 text-right">
                    <a href="/books/{{this.id}}" class="px-3 py-1.5 text-xs bg-indigo-600 text-white rounded-lg hover:bg-indigo-700">View</a>
                  </td>
                </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
      {{else}}
        <div class="text-center py-20 bg-white rounded-xl border border-gray-100">
          <p class="text-gray-500 text-lg">No books found.</p>
          <a href="/books" class="mt-3 inline-block text-indigo-600 hover:underline">Clear filters</a>
        </div>
      {{/if}}
    </div>
  </div>
</div>
{{> footer}}