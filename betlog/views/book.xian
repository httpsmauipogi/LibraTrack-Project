{{> head}}
<body class="bg-gray-50">
{{> navbar}}

<div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <a href="/books" class="text-sm text-indigo-600 mb-4 inline-block hover:underline">&larr; Back to Catalog</a>

  <div class="rounded-xl border border-gray-100 bg-white p-5 shadow sm:p-8">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div class="min-w-0">
        <span class="inline-block rounded bg-indigo-50 px-2 py-0.5 text-xs font-medium text-indigo-700">{{book.genre}}</span>
        <h1 class="mt-3 text-2xl font-bold text-gray-900 sm:text-3xl">{{book.title}}</h1>
        <p class="mt-1 text-base text-gray-600 sm:text-lg">by {{book.author}}</p>
      </div>
    </div>

    <div class="mt-8 grid grid-cols-1 gap-3 text-sm xs:grid-cols-2 sm:gap-4">
      <div class="bg-gray-50 rounded-lg p-4">
        <p class="text-gray-500">Total Copies</p>
        <p class="font-semibold text-gray-900 mt-1">{{book.copies}}</p>
      </div>
      <div class="bg-gray-50 rounded-lg p-4">
        <p class="text-gray-500">Available</p>
        <p class="font-semibold text-gray-900 mt-1">{{book.available}}</p>
      </div>
    </div>

    <div class="mt-8">
      {{#if alreadyBorrowed}}
        <div class="bg-amber-50 border border-amber-200 p-4 rounded-lg">
          <p class="text-amber-800 text-sm">You already have a <strong class="capitalize">{{alreadyBorrowed.status}}</strong> borrowing request for this book.</p>
        </div>
      {{else if book.available}}
        <form method="POST" action="/books/{{book.id}}/borrow">
          <button type="submit" class="min-h-[48px] w-full rounded-lg bg-indigo-600 px-6 py-4 font-semibold text-white hover:bg-indigo-700">Borrow This Book</button>
        </form>
      {{else}}
        <button disabled class="w-full px-6 py-4 bg-gray-200 text-gray-400 font-semibold rounded-lg cursor-not-allowed">Currently Unavailable</button>
      {{/if}}
    </div>
  </div>
</div>
{{> footer}}