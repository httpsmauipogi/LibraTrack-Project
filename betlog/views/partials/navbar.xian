<nav class="bg-white shadow border-b border-gray-100 sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between h-16">
      <div class="flex items-center gap-8">
        <a href="/" class="flex items-center gap-2">
          <span class="text-2xl font-bold text-indigo-600">LibraTrack</span>
          <span class="hidden sm:inline text-sm font-medium text-gray-500">Library</span>
        </a>
        <div class="hidden md:flex items-center gap-6 text-sm">
          <a href="/books" class="text-gray-600 hover:text-indigo-600 {{#if (eq currentPath '/books')}}text-indigo-600 font-medium{{/if}}">Catalog</a>
          {{#if user}}
            {{#if (or (eq user.role "admin") (eq user.role "staff"))}}
              <a href="/admin/books" class="hidden sm:inline px-3 py-2 text-sm text-gray-600 hover:text-indigo-600 {{#if (eq currentPath '/admin/books')}}text-indigo-600 font-medium{{/if}}">Manage Books</a>
            {{else}}
              <a href="/borrowings" class="hidden sm:inline px-3 py-2 text-sm text-gray-600 hover:text-indigo-600 {{#if (eq currentPath '/borrowings')}}text-indigo-600 font-medium{{/if}}">My Borrowings</a>
            {{/if}}
            <a href="/dashboard" class="hidden sm:inline px-3 py-2 text-sm text-gray-600 hover:text-indigo-600 {{#if (eq currentPath '/dashboard')}}text-indigo-600 font-medium{{/if}}">Dashboard</a>
          {{/if}}
        </div>
      </div>
      <div class="hidden lg:flex items-center flex-1 max-w-md mx-6">
        <form action="/books" method="GET" class="flex w-full">
          <input name="q" type="text" placeholder="Search by title, author, ISBN..." value="{{q}}" class="w-full px-4 py-2 border border-gray-300 rounded-l-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none"/>
          <button type="submit" class="px-5 py-2 bg-indigo-600 text-white rounded-r-lg hover:bg-indigo-700">Search</button>
        </form>
      </div>
      <div class="flex items-center gap-3">
        {{#if user}}
          {{#if (or (eq user.role "admin") (eq user.role "staff"))}}
            <a href="/admin/books" class="hidden sm:inline px-3 py-2 text-sm text-gray-600 hover:text-indigo-600 {{#if (eq currentPath '/admin/books')}}text-indigo-600 font-medium{{/if}}">Manage Books</a>
          {{/if}}
          <div class="relative">
            <button class="flex items-center gap-2 p-1.5 rounded-full hover:bg-gray-100" onclick="this.nextElementSibling.classList.toggle('hidden')">
              <span class="w-8 h-8 rounded-full bg-indigo-100 text-indigo-700 flex items-center justify-center text-sm font-semibold">{{initial user.name}}</span>
              <span class="hidden sm:inline text-sm text-gray-700">{{user.name}}</span>
              <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </button>
            <div class="hidden absolute right-0 mt-2 w-52 bg-white rounded-lg shadow-lg border border-gray-100 py-2">
              <div class="px-4 py-2 border-b border-gray-100">
                <p class="text-sm font-medium text-gray-900">{{user.name}}</p>
                <p class="text-xs text-gray-500">{{user.email}}</p>
                <span class="inline-block mt-1 px-2 py-0.5 text-xs rounded bg-indigo-50 text-indigo-700 capitalize">{{user.role}}</span>
              </div>
              <a href="/dashboard" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50">Dashboard</a>
              {{#if (or (eq user.role "admin") (eq user.role "staff"))}}
                <a href="/admin/books" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50">Manage Books</a>
                <a href="/admin/borrowings" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50">Manage Borrowings</a>
              {{else}}
                <a href="/borrowings" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50">My Borrowings</a>
              {{/if}}
              <a href="/logout" class="block px-4 py-2 text-sm text-red-600 hover:bg-gray-50">Logout</a>
            </div>
          </div>
        {{else}}
          <a href="/login" class="px-4 py-2 text-sm text-gray-600 hover:text-indigo-600">Login</a>
          <a href="/register" class="px-4 py-2 text-sm bg-indigo-600 text-white rounded-lg hover:bg-indigo-700">Register</a>
        {{/if}}
      </div>
    </div>
  </div>
</nav>

{{#if success_msg}}
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-4">
    <div class="bg-green-50 border border-green-200 text-green-800 px-4 py-3 rounded-lg text-sm">{{success_msg}}</div>
  </div>
{{/if}}
{{#if error_msg}}
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-4">
    <div class="bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded-lg text-sm">{{error_msg}}</div>
  </div>
{{/if}}