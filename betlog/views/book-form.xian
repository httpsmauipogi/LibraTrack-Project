{{> head}}
<body class="bg-gray-50">
{{> navbar}}

<div class="max-w-xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <h1 class="text-2xl font-bold text-gray-900 mb-6">{{#if book}}Edit Book{{else}}Add Book{{/if}}</h1>

  <form method="POST" action="{{#if book}}/admin/books/{{book.id}}{{else}}/admin/books{{/if}}" class="space-y-4 rounded-xl border border-gray-100 bg-white p-5 shadow sm:p-8">
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Title</label>
      <input name="title" type="text" required value="{{book.title}}" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none"/>
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Author</label>
      <input name="author" type="text" required value="{{book.author}}" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none"/>
    </div>
    <div class="grid grid-cols-1 gap-4 xs:grid-cols-2">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Category</label>
        <input name="category" type="text" value="{{book.category}}" placeholder="Fiction, Science, History..." class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none"/>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Copies</label>
        <input name="totalCopies" type="number" min="1" required value="{{#if book}}{{book.totalCopies}}{{else}}1{{/if}}" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none"/>
      </div>
    </div>
    <div class="flex flex-col-reverse gap-2 pt-2 sm:flex-row sm:gap-3">
      <button type="submit" class="min-h-[44px] flex-1 rounded-lg bg-indigo-600 px-6 py-3 font-semibold text-white hover:bg-indigo-700">{{#if book}}Save Changes{{else}}Add Book{{/if}}</button>
      <a href="/admin/books" class="inline-flex min-h-[44px] items-center justify-center px-6 py-3 text-gray-600 hover:text-gray-800">Cancel</a>
    </div>
  </form>
</div>
{{> footer}}