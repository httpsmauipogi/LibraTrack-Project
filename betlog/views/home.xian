{{> head}}
<body class="bg-gray-50">
{{> navbar}}

<!-- Hero -->
<section class="bg-gradient-to-r from-indigo-700 to-blue-700 text-white">
  <div class="mx-auto max-w-7xl px-4 py-12 text-center sm:px-6 sm:py-16 lg:px-8 lg:py-24">
    <h1 class="mb-4 text-3xl font-extrabold sm:text-4xl md:text-5xl">LibraTrack Library</h1>
    <p class="mx-auto mb-8 max-w-2xl text-base text-indigo-100 sm:text-lg md:text-xl">Borrow and return books online. Browse the catalog, submit a request, and track your borrowings — all in one place.</p>
    <div class="flex flex-wrap justify-center gap-3 sm:gap-4">
      <a href="/books" class="inline-flex min-h-[44px] items-center rounded-lg bg-white px-5 py-3 font-semibold text-indigo-700 hover:bg-indigo-50 sm:px-8">Browse Books</a>
      {{#if user}}
        <a href="/borrowings" class="inline-flex min-h-[44px] items-center rounded-lg border border-white/40 bg-white/10 px-5 py-3 font-semibold text-white hover:bg-white/20 sm:px-8">My Borrowings</a>
      {{else}}
        <a href="/register" class="inline-flex min-h-[44px] items-center rounded-lg border border-white/40 bg-white/10 px-5 py-3 font-semibold text-white hover:bg-white/20 sm:px-8">Get a Library Card</a>
      {{/if}}
    </div>
    <div class="mx-auto mt-10 max-w-xl">
      <form action="/books" method="GET" class="flex flex-col gap-2 sm:flex-row">
        <input name="q" type="text" placeholder="Search by title or author..." class="w-full min-w-0 rounded-lg px-5 py-3 text-gray-800 outline-none sm:rounded-r-none"/>
        <button type="submit" class="min-h-[44px] shrink-0 rounded-lg bg-indigo-900/60 px-6 py-3 font-medium text-white hover:bg-indigo-900 sm:rounded-l-none">Search</button>
      </form>
    </div>
  </div>
</section>

<!-- Genres -->
{{#if genres.length}}
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
  <div class="flex flex-wrap gap-3 justify-center">
    {{#each genres}}
      <a href="/books?genre={{this}}" class="px-4 py-2 bg-white border border-gray-200 rounded-full text-sm text-gray-700 hover:border-indigo-400 hover:text-indigo-600">{{this}}</a>
    {{/each}}
  </div>
</section>
{{/if}}

<!-- Featured books -->
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
  <div class="mb-6 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <h2 class="text-2xl font-bold text-gray-900">All Books</h2>
      <p class="mt-1 text-gray-500">Browse the library collection</p>
    </div>
    <a href="/books" class="text-sm font-medium text-indigo-600 hover:underline">View catalog &rarr;</a>
  </div>

  {{#if featured.length}}
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 sm:gap-6 lg:grid-cols-3">
      {{#each featured}}
        <a href="/books/{{this.id}}" class="group rounded-xl border border-gray-100 bg-white p-5 shadow transition hover:shadow-md sm:p-6">
          <div class="flex justify-between items-start gap-3">
            <h3 class="font-semibold text-gray-900 line-clamp-2 group-hover:text-indigo-600">{{this.title}}</h3>
            <span class="shrink-0 px-2 py-0.5 text-xs font-medium rounded {{#if this.available}}bg-green-100 text-green-700{{else}}bg-red-100 text-red-700{{/if}}">{{#if this.available}}Available{{else}}Unavailable{{/if}}</span>
          </div>
          <p class="text-sm text-gray-500 mt-1">{{this.author}}</p>
          <p class="text-xs text-indigo-600 mt-2">{{this.genre}}</p>
          <p class="text-xs text-gray-400 mt-3">{{this.available}} of {{this.copies}} copies available</p>
        </a>
      {{/each}}
    </div>
  {{else}}
    <div class="text-center py-16 bg-white rounded-xl border border-gray-100">
      <p class="text-gray-500">No books in the library yet.</p>
    </div>
  {{/if}}
</section>

<!-- How it works -->
<section class="bg-white border-y border-gray-100">
  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 sm:py-14 lg:px-8">
    <h2 class="mb-8 text-center text-2xl font-bold text-gray-900 sm:mb-10">How It Works</h2>
    <div class="grid grid-cols-1 gap-6 md:grid-cols-3 md:gap-8">
      <div class="text-center">
        <div class="w-14 h-14 mx-auto rounded-full bg-indigo-100 text-indigo-600 flex items-center justify-center text-xl font-bold">1</div>
        <h3 class="mt-4 font-semibold text-gray-900">Browse &amp; Request</h3>
        <p class="text-sm text-gray-500 mt-1">Find a book and submit a borrow request.</p>
      </div>
      <div class="text-center">
        <div class="w-14 h-14 mx-auto rounded-full bg-indigo-100 text-indigo-600 flex items-center justify-center text-xl font-bold">2</div>
        <h3 class="mt-4 font-semibold text-gray-900">Approval</h3>
        <p class="text-sm text-gray-500 mt-1">Library staff approves your request.</p>
      </div>
      <div class="text-center">
        <div class="w-14 h-14 mx-auto rounded-full bg-indigo-100 text-indigo-600 flex items-center justify-center text-xl font-bold">3</div>
        <h3 class="mt-4 font-semibold text-gray-900">Return</h3>
        <p class="text-sm text-gray-500 mt-1">Return the book when you're done.</p>
      </div>
    </div>
  </div>
</section>

{{> footer}}