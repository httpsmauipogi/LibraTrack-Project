{{> head}}
<body class="bg-gray-50">
{{> navbar}}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">Borrowing Records</h1>
      <p class="text-sm text-gray-500 mt-1">Every borrowing record currently stored in the shared database is listed below.</p>
    </div>
    <span class="text-sm text-gray-500">{{borrowings.length}} record{{#if (ne borrowings.length 1)}}s{{/if}}</span>
  </div>

  <!-- BORROWED BOOKS -->
  <section class="bg-white rounded-xl shadow border border-gray-100 overflow-hidden">
    <div class="flex flex-col gap-2 border-b border-gray-100 px-4 py-4 sm:flex-row sm:items-center sm:justify-between sm:px-6">
      <h2 class="text-lg font-bold text-gray-900">Borrowed books</h2>
      <span class="text-xs text-gray-500">{{borrowedBooks.length}} record{{#if (ne borrowedBooks.length 1)}}s{{/if}}</span>
    </div>

    {{#if borrowedBooks.length}}
      <div class="lt-table-wrap custom-scrollbar">
        <table class="lt-table lt-table-wide divide-y divide-gray-100">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Member</th>
              <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Book</th>
              <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Status</th>
              <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Borrowed</th>
              <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Due Date</th>
              <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Returned</th>
              <th class="px-6 py-3 text-right text-xs font-semibold text-gray-500 uppercase">Action</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            {{#each borrowedBooks}}
              <tr class="hover:bg-gray-50">
                <td class="px-6 py-4 text-sm text-gray-700">{{this.user.name}}</td>
                <td class="px-6 py-4 text-sm font-medium text-gray-900">{{this.book.title}}</td>
                <td class="px-6 py-4">
                  <span class="px-2 py-0.5 text-xs font-semibold rounded {{#if (eq this.statusLabel 'ACTIVE')}}bg-indigo-100 text-indigo-700{{else if (eq this.statusLabel 'OVERDUE')}}bg-red-100 text-red-700{{else if (eq this.statusLabel 'RETURNED')}}bg-green-100 text-green-700{{else}}bg-gray-100 text-gray-700{{/if}}">{{this.statusLabel}}</span>
                </td>
                <td class="px-6 py-4 text-sm text-gray-500">{{date this.borrowDate}}</td>
                <td class="px-6 py-4 text-sm text-gray-500">{{date this.dueDate}}</td>
                <td class="px-6 py-4 text-sm text-gray-500">{{date this.returnDate}}</td>
                <td class="px-6 py-4 text-right">
                  {{#if this.isReturnable}}
                    <form method="POST" action="/admin/borrowings/{{this.id}}/return" class="inline">
                      <button type="submit" class="bg-indigo-600 text-white px-3 py-1.5 rounded-lg text-sm hover:bg-indigo-700">Mark Returned</button>
                    </form>
                  {{else}}
                    <span class="text-xs text-gray-400">-</span>
                  {{/if}}
                </td>
              </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    {{else}}
      <div class="py-12 text-center">
        <p class="text-sm text-gray-500">No borrowed books have been recorded.</p>
      </div>
    {{/if}}
  </section>

  <!-- REQUESTS AND CLOSED RECORDS -->
  <section class="bg-white rounded-xl shadow border border-gray-100 overflow-hidden">
    <div class="flex flex-col gap-2 border-b border-gray-100 px-4 py-4 sm:flex-row sm:items-center sm:justify-between sm:px-6">
      <div>
        <h2 class="text-lg font-bold text-gray-900">Requests &amp; closed records</h2>
        <p class="text-xs text-gray-500 mt-1">Pending requests are reviewed in the central admin console.</p>
      </div>
      <span class="text-xs text-gray-500">{{requestHistory.length}} record{{#if (ne requestHistory.length 1)}}s{{/if}}</span>
    </div>

    {{#if requestHistory.length}}
      <div class="lt-table-wrap custom-scrollbar">
        <table class="lt-table lt-table-wide divide-y divide-gray-100">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Request</th>
              <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Member</th>
              <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Book</th>
              <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Status</th>
              <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Submitted</th>
              <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Note</th>
              <th class="px-6 py-3 text-right text-xs font-semibold text-gray-500 uppercase">Action</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            {{#each requestHistory}}
              <tr class="hover:bg-gray-50">
                <td class="px-6 py-4 font-mono text-xs text-gray-500">REQ-{{this.id}}</td>
                <td class="px-6 py-4 text-sm text-gray-700">{{this.user.name}}</td>
                <td class="px-6 py-4 text-sm font-medium text-gray-900">{{this.book.title}}</td>
                <td class="px-6 py-4">
                  <span class="px-2 py-0.5 text-xs font-semibold rounded {{#if (eq this.statusLabel 'PENDING')}}bg-amber-100 text-amber-700{{else if (eq this.statusLabel 'REJECTED')}}bg-gray-200 text-gray-700{{else}}bg-gray-100 text-gray-700{{/if}}">{{this.statusLabel}}</span>
                </td>
                <td class="px-6 py-4 text-sm text-gray-500">{{date this.createdAt}}</td>
                <td class="px-6 py-4 text-sm text-gray-500">{{this.notes}}</td>
                <td class="px-6 py-4 text-right">
                  {{#if this.isReview}}
                    <a href="{{adminConsoleUrl}}/admin/requests" class="text-xs font-semibold text-indigo-600 hover:underline">Review in Admin Console</a>
                  {{else}}
                    <span class="text-xs text-gray-400">Closed</span>
                  {{/if}}
                </td>
              </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    {{else}}
      <div class="py-12 text-center">
        <p class="text-sm text-gray-500">No pending or closed requests.</p>
      </div>
    {{/if}}
  </section>
</div>
{{> footer}}
